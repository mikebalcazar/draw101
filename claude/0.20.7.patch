+  /* Ruta abreviada para la lista de recientes (Mike, 15-sep-2026: «no
+   * necesitamos toda la ruta»). Se conservan el arranque (unidad o primera
+   * carpeta) y el final (última carpeta y archivo), con «…» en medio; la ruta
+   * completa va en el tooltip. */
+  function abreviarRuta(ruta, max = 64) {
+    if (!ruta || ruta.length <= max) return ruta;
+    const sep = ruta.includes("\\") ? "\\" : "/";
+    const partes = ruta.split(sep).filter((p) => p.length);
+    if (partes.length <= 3) return ruta.slice(0, 8) + "…" + ruta.slice(-(max - 9));
+    const inicio = partes.slice(0, 2).join(sep);
+    let fin = partes.slice(-2).join(sep);
+    if (fin.length > max - 12) fin = "…" + fin.slice(-(max - 12));
+    return inicio + sep + "…" + sep + fin;
+  }

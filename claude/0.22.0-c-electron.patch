+/* --- la nube (draw101 0.22.0) --- */
+
+/* Ninguno de estos avienta: contestan por qué no se pudo. Si la nube falla, se
+ * sigue dibujando y guardando en la máquina, que es lo que importa. */
+ipcMain.handle("nube-indice-ya", () => nube.indiceYa());
+ipcMain.handle("nube-indice-bajar", () => nube.bajarIndice());
+ipcMain.handle("nube-encendida", () => nube.encendida());
+ipcMain.handle("nube-prender", (_e, si) => nube.prender(!!si));
+ipcMain.handle("nube-subir", (_e, datos) => nube.subirPlano(datos || {}));
+ipcMain.handle("nube-quitar", (_e, doc) => nube.quitarPlano({ doc }));
+
+/* Bajar un plano de la nube deja un archivo en la máquina y devuelve su ruta,
+ * porque el motor abre rutas y no bytes. Va a una carpeta aparte para que
+ * nunca escriba encima del archivo que el dibujante tiene abierto: quién gana
+ * entre la copia de la nube y la de aquí lo decide él (paso 7), no esto. */
+ipcMain.handle("nube-bajar", async (_e, doc, version) => {
+  const r = await nube.bajarPlano({ doc, version });
+  if (!r.ok) return r;
+  try {
+    const dir = path.join(nube.carpeta(), "de-la-nube");
+    fs.mkdirSync(dir, { recursive: true });
+    const limpio = String(r.nombre || doc).replace(/[\\/:*?"<>|]/g, "-");
+    const ruta = path.join(dir, limpio.toLowerCase().endsWith(".t101d") ? limpio : limpio + ".t101d");
+    fs.writeFileSync(ruta, r.datos);
+    return { ok: true, ruta, nombre: r.nombre, version: r.version, modificado: r.modificado };
+  } catch (e) {
+    return { error: e.message };
+  }
+});
+

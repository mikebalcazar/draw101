diff --git a/electron/nube.js b/electron/nube.js
new file mode 100644
index 0000000..baa68c3
--- /dev/null
+++ b/electron/nube.js
@@ -0,0 +1,188 @@
+/* La nube de draw101 vista desde el proceso principal: la llave, el índice y
+ * las subidas. Aquí se junta el núcleo (electron/nube-nucleo.js, que no sabe
+ * nada de Electron y por eso se puede medir con `node`) con lo que sí es de
+ * esta app: dónde vive la licencia, cuál es la API, y cómo se le avisa a la
+ * pantalla.
+ *
+ * TRES DECISIONES QUE VALE LA PENA EXPLICAR, porque las tres son sobre lo
+ * mismo: que la nube no pueda estorbarle a alguien que está dibujando.
+ *
+ * 1. EL ÍNDICE SE BAJA DESPUÉS DE ABRIR LA VENTANA, nunca antes. Mike lo pidió
+ *    al arrancar («draw descarga una lista de los archivos en la nube cuando
+ *    arranca para poder buscarlos indizados»), y así es: se pide en cuanto la
+ *    ventana existe, no antes de que exista. Si se pidiera antes, un servidor
+ *    lento o un hotel con mal wifi serían un draw101 que tarda en abrir, y eso
+ *    es peor que un buscador que tarda diez segundos en tener datos.
+ *
+ * 2. EL ÍNDICE SE GUARDA EN LA MÁQUINA, con los nombres YA descifrados. Sin
+ *    internet la pantalla de «Mis archivos en la nube» sigue enseñando la lista
+ *    de la última vez —marcada como de la última vez— en lugar de estar vacía y
+ *    parecer que se perdieron los archivos. Se guarda descifrado porque para
+ *    descifrarlo haría falta la llave, que ya está en la misma carpeta: fingir
+ *    que ahí hay una barrera sería mentirse.
+ *
+ * 3. NADA DE ESTO PUEDE TIRAR LA APP. Cada llamada devuelve por qué no se pudo
+ *    —`sinRed`, `sinLicencia`, `apagada`, `error`— y ninguna avienta. Guardar un
+ *    plano tiene que funcionar igual con la nube caída; subirlo es lo que puede
+ *    esperar.
+ */
+
+const path = require("path");
+const os = require("os");
+const fs = require("fs");
+const licencia = require("./licencia");
+const n = require("./nube-nucleo");
+
+const carpeta = () => path.join(os.homedir(), "Taller 101", "draw101");
+const archivoIndice = () => path.join(carpeta(), "nube-indice.json");
+
+/* --- el interruptor (paso 6) --- */
+
+/* Mike: «Todo sube por default, o desactivas todo. No hay selección de
+ * archivos». Así que está encendida hasta que alguien la apague, y lo apagado
+ * es lo que se guarda. */
+function encendida() {
+  const g = n.guardado(carpeta());
+  return g.nube_apagada !== true;
+}
+
+function prender(si) {
+  const g = n.guardado(carpeta());
+  n.guardar(carpeta(), { ...g, nube_apagada: !si });
+  return encendida();
+}
+
+/* --- la llave --- */
+
+const elToken = () => (licencia.guardada() || {}).token || "";
+
+async function laLlave({ forzar = false } = {}) {
+  return n.llave({ api: licencia.API, carpeta: carpeta(), token: elToken(), forzar });
+}
+
+/* --- el índice --- */
+
+/* Lo último que se bajó. Se lee de la máquina, y si no hay nada, se dice que no
+ * hay nada en vez de inventar una lista vacía: no es lo mismo «no tienes
+ * archivos» que «todavía no he podido preguntar». */
+function indiceGuardado() {
+  try {
+    const d = JSON.parse(fs.readFileSync(archivoIndice(), "utf8"));
+    if (Array.isArray(d.archivos)) return d;
+  } catch { /* no hay, o quedó a medias */ }
+  return null;
+}
+
+function guardarIndice(d) {
+  try {
+    fs.mkdirSync(carpeta(), { recursive: true });
+    // A un temporal y luego encima: un apagón a la mitad no deja un JSON roto
+    // que la próxima vez no se pueda leer.
+    const tmp = archivoIndice() + ".tmp";
+    fs.writeFileSync(tmp, JSON.stringify(d));
+    fs.renameSync(tmp, archivoIndice());
+  } catch { /* si no se puede guardar, se sigue sin caché */ }
+}
+
+let bajando = null;   // para que dos llamadas juntas no pidan dos veces
+
+/** Baja el índice y lo guarda. Si no se puede, devuelve lo guardado marcado
+ *  `de_cache`, que es lo que hace que la pantalla sirva sin internet. */
+async function bajarIndice() {
+  if (!encendida()) return { apagada: true, archivos: [] };
+  if (bajando) return bajando;
+
+  bajando = (async () => {
+    const token = elToken();
+    if (!token) return { sinLicencia: true, ...(indiceGuardado() ? { ...indiceGuardado(), de_cache: true } : { archivos: [] }) };
+
+    const l = await laLlave();
+    if (!l.llave) {
+      const viejo = indiceGuardado();
+      return { ...l, ...(viejo ? { ...viejo, de_cache: true } : { archivos: [] }) };
+    }
+
+    const r = await n.indice({ api: licencia.API, token, llave: l.llave });
+    if (r.archivos) {
+      const d = { archivos: r.archivos, al: r.al || new Date().toISOString() };
+      guardarIndice(d);
+      return d;
+    }
+    const viejo = indiceGuardado();
+    return { ...r, ...(viejo ? { ...viejo, de_cache: true } : { archivos: [] }) };
+  })();
+
+  try { return await bajando; } finally { bajando = null; }
+}
+
+/** Lo que la pantalla pide: lo guardado al instante, sin esperar la red. */
+function indiceYa() {
+  if (!encendida()) return { apagada: true, archivos: [] };
+  const d = indiceGuardado();
+  return d ? { ...d, de_cache: true } : { archivos: [], todavia_no: true };
+}
+
+/* --- subir y bajar un plano --- */
+
+async function subirPlano({ doc, nombre, ruta, modificado }) {
+  if (!encendida()) return { apagada: true };
+  const token = elToken();
+  if (!token) return { sinLicencia: true };
+  // Un token mal formado se rechaza AQUÍ. Antes esta línea llamaba a
+  // `archivoNube(doc)`, que arma una ruta y siempre devuelve algo verdadero: o
+  // sea que no comprobaba nada, y un documento sin token habría subido bajo un
+  // nombre que no identifica a nada.
+  if (!n.tokenValido(doc)) return { error: "ese documento no trae un token válido" };
+
+  const l = await laLlave();
+  if (!l.llave) return l;
+
+  let datos;
+  try { datos = fs.readFileSync(ruta); } catch (e) { return { error: e.message }; }
+
+  const r = await n.subir({
+    api: licencia.API, token, llave: l.llave, doc,
+    nombre: nombre || path.basename(ruta), datos,
+    modificado: modificado || new Date().toISOString(),
+  });
+  // Al subir, el renglón del índice guardado se pone al día sin volver a
+  // pedirlo: si no, la pantalla enseñaría la versión de antes hasta el
+  // siguiente arranque.
+  if (r.ok) alDia({ token: doc, nombre: nombre || path.basename(ruta), bytes: datos.length,
+                     version: r.version, modificado: modificado || new Date().toISOString() });
+  return r;
+}
+
+async function bajarPlano({ doc, version }) {
+  const token = elToken();
+  if (!token) return { sinLicencia: true };
+  const l = await laLlave();
+  if (!l.llave) return l;
+  return n.bajar({ api: licencia.API, token, llave: l.llave, doc, version });
+}
+
+async function quitarPlano({ doc }) {
+  const token = elToken();
+  if (!token) return { sinLicencia: true };
+  const r = await n.quitar({ api: licencia.API, token, doc });
+  if (r.ok) {
+    const d = indiceGuardado();
+    if (d) guardarIndice({ ...d, archivos: d.archivos.filter((a) => a.token !== doc) });
+  }
+  return r;
+}
+
+/** Mete o actualiza un renglón en el índice guardado. */
+function alDia(fila) {
+  const d = indiceGuardado() || { archivos: [], al: new Date().toISOString() };
+  const otros = d.archivos.filter((a) => a.token !== fila.token);
+  const antes = d.archivos.find((a) => a.token === fila.token);
+  guardarIndice({ ...d, archivos: [{ ...antes, ...fila }, ...otros] });
+}
+
+module.exports = {
+  encendida, prender, laLlave,
+  bajarIndice, indiceYa, indiceGuardado,
+  subirPlano, bajarPlano, quitarPlano,
+  carpeta, archivoIndice,
+};

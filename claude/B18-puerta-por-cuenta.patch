+def huella_maquina() -> str:
+    """El identificador de este equipo: lo que la suite cuenta como un «lugar».
+
+    **Es un azar guardado la primera vez**, no el nombre del equipo ni la MAC
+    ni el número de serie del disco. No identifica a la persona y no se puede
+    volver atrás; el nombre del equipo entra sólo como sal. Reinstalar Windows
+    cuenta como equipo nuevo, que es lo honesto —para la suite lo es—, y el
+    lugar viejo se libera desde master101.
+
+    Vive en `equipo.json`, **el mismo archivo y la misma carpeta** que usa la
+    puerta de arranque (`electron/licencia-nucleo.js`). Tiene que ser el mismo
+    valor en los dos lados: el permiso viene atado a una huella, y si el motor
+    calculara otra, rechazaría el permiso que la puerta acaba de conseguir y
+    la app abriría diciendo «sin activar». Antes esto era un resumen de
+    nombre+usuario+arquitectura, y por eso no cuadraban.
     """
+    archivo = _archivo_equipo()
+    try:
+        guardado = json.loads(archivo.read_text(encoding="utf-8"))

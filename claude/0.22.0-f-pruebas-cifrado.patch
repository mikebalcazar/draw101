@@ -0,0 +1,98 @@
+"""t048 · El núcleo de la nube: que lo que sale de esta máquina salga cifrado.
+
+Los archivos de draw101 se copian a la nube, y **ninguna cuenta puede abrir los
+de otra**. Ésa es la promesa que el cifrado sostiene, así que aquí no es un
+adorno.
+
+Lo que el cifrado NO promete, y conviene que lo diga la prueba y no sólo el
+código: el servidor sí puede abrirlos. Mike escogió eso el mismo día y lo
+confirmó a propósito después de que se le dijera que deshacía su decisión
+anterior —«que el servidor pueda — nadie pierde nada nunca»—, porque las máquinas
+que entran con cuenta de suite nunca teclean una clave T101 y con el diseño
+anterior no habrían podido bajar sus archivos. Lo que sigue en pie: un volcado
+del bucket no abre un plano, y el servidor no sabe ni cómo se llaman.
+
+El cifrado vive en `electron/nube-nucleo.js` —en el proceso principal de
+Electron— por una razón práctica: Node trae AES-256-GCM de fábrica y la
+biblioteca estándar de Python no. Así que, igual que con la puerta de licencia
+(t036), hay código de la app que Python no puede medir por su cuenta. Se mide
+corriendo node, desde aquí, para que entre en cada armado y no quede como una
+prueba que alguien corre «cuando se acuerde».
+
+Lo que mide `pruebas/nube.mjs`, y por qué eso y no otra cosa:
+
+  · **Que el nonce nunca se repita.** Es la única regla de AES-GCM que, rota,
+    no se nota jamás probando a mano: todo sigue cifrando y descifrando bien.
+    Pero con la misma llave y el mismo nonce dos veces, lo cifrado se puede
+    recuperar sin la llave. Y aquí el mismo plano se sube docenas de veces con
+    la misma llave de la cuenta, así que es el riesgo real, no el de libro.
+
+  · **Que descifrar FALLE cuando algo llegó tocado**, en vez de devolver basura.
+    Un `.t101d` con basura dentro, escrito encima del archivo bueno de alguien,
+    es la peor manera posible de fallar en todo esto.
+
+  · **Que se distinga «no se pudo llegar» de «el servidor dijo que no».**
+    Confundirlas deja a un taller sin sus archivos porque el servidor tuvo un
+    mal rato. Es exactamente lo que ya vigila t036 para la puerta.
+
+  · **Que un renglón ilegible no tumbe la lista entera.** Perder el índice
+    completo por un archivo raro sería cambiar un problema chico por uno grande.
+
+Las comprobaciones se verificaron rompiendo el código a propósito: con el nonce
+fijo falla la del nonce; devolviendo el bulto crudo falla la de descifrar; y sin
+el `try` del nombre fallan cuatro de golpe. O sea que miden algo.
+"""
+
+from __future__ import annotations
+
+import pathlib
+import re
+import shutil
+import subprocess
+
+from pruebas import comun
+
+DESCRIPCION = "el núcleo de la nube cifra de verdad y no confunde «sin red» con «no»"
+
+RAIZ = pathlib.Path(__file__).resolve().parent.parent
+
+# Si se agregan comprobaciones a nube.mjs, este número sube. Está aquí a
+# propósito: sin él, borrar media prueba pasaría desapercibido porque el
+# programa seguiría saliendo con 0.
+MINIMO = 36
+
+
+def correr(r: comun.Reporte) -> None:
+    nucleo = RAIZ / "electron" / "nube-nucleo.js"
+    prueba = RAIZ / "pruebas" / "nube.mjs"
+
+    r.cierto(nucleo.exists(), "electron/nube-nucleo.js debería existir: es el cifrado de la nube")
+    if not prueba.exists():
+        r.cierto(False, "pruebas/nube.mjs debería existir: es lo que mide el cifrado")
+        return
+
+    # El cifrado NO puede vivir en el proceso de la ventana: ahí lo alcanza
+    # cualquier cosa que se cargue en la página. Se revisa aquí porque moverlo
+    # «para que sea más fácil» es un cambio que se ve inofensivo y no lo es.
+    fuente = nucleo.read_text(encoding="utf-8")
+    # `require("crypto")` a secas, como electron/licencia-nucleo.js: es el del
+    # propio Node. Lo que se vigila es que no aparezca un paquete de fuera.
+    r.cierto(re.search(r'require\(["\']crypto["\']\)', fuente) is not None,
+             "el cifrado usa el crypto de Node, no uno traído de fuera")
+    r.cierto(not re.search(r'require\(["\'](?!crypto|fs|path|os|node:)', fuente),
+             "y el núcleo no depende de ningún paquete instalado: se puede medir con node a secas")
+    r.cierto("aes-256-gcm" in fuente, "y es AES-256-GCM, que además avisa si tocaron el bulto")
+
+    node = shutil.which("node")
+    if not node:
+        r.cierto(True, "sin node no se puede medir el cifrado: se salta")
+        return
+
+    salida = subprocess.run([node, str(prueba)], cwd=str(RAIZ),
+                            capture_output=True, text=True, timeout=180)
+    cuantas = salida.stdout.count("  ok   ")
+    r.cierto(salida.returncode == 0,
+             f"el núcleo de la nube pasa sus {MINIMO} comprobaciones",
+             (salida.stdout + salida.stderr)[-600:])
+    r.cierto(cuantas >= MINIMO,
+             f"y se corrieron todas ({cuantas} comprobaciones)")
# fin del parche: el renglon de cola absorbe el recorte del conector.

+  /* La ayuda, en una línea corta (Mike, 16-sep-2026: la lista estaba muy
+   * grande). La de un comando puede traer todas sus formas: «CIRCULO [2P · 3P
+   * · D] — centro y radio; dos puntos del diámetro; tres puntos…». En la lista
+   * basta la primera idea: se quita el encabezado que repite el nombre —que ya
+   * va en la fila—, se corta en el guión largo, el punto y coma o el
+   * paréntesis, y como mucho a 34 letras. */
+  function corta(texto, nombre) {
+    let t = String(texto).trim();
+    // Sólo cuando de verdad se repite como encabezado: «CIRCULO [2P · 3P] —»
+    // o «CIRCULO —». Nunca cuando la palabra sigue la frase («Cota lineal…»).
+    const conNombre = new RegExp(`^${nombre}\\s*(\\[[^\\]]*\\])?\\s*[—:]\\s*`, "i");
+    t = t.replace(conNombre, "");
+    t = t.split(/\s+—\s+|\s*[;(]\s*/)[0].trim();
+    if (t.length > 34) t = t.slice(0, 33).trimEnd() + "…";
+    return t;
+  }

diff --git a/build/python-mac.sh b/build/python-mac.sh
new file mode 100755
index 0000000..9f2d4c8
--- /dev/null
+++ b/build/python-mac.sh
@@ -0,0 +1,111 @@
+#!/usr/bin/env bash
+# Arma el Python empotrado para macOS  ·  draw101
+#
+# Mike, 24-nov-2026: «¿podemos hacer la version para macos?».
+#
+# POR QUÉ ESTE ARCHIVO EXISTE, SIENDO QUE YA HAY UNO
+#
+# `build/python-empotrado.sh` saca el Python de Windows **del instalador
+# anterior de draw101**, con una cadena que llega hasta la 0.20.1. Para macOS
+# no hay instalador anterior del cual sacarlo: hay que armarlo de cero, una
+# vez, y de ahí en adelante este guión lo rehace igual en cada entrega.
+#
+# De dónde sale el intérprete: `python-build-standalone`, que son CPython
+# portables ya compilados. No es una fuente exótica: es lo que usa `uv` por
+# debajo para instalar versiones de Python, y los publica el mismo equipo.
+#
+# POR QUÉ x86_64 Y NO arm64, que parecería lo moderno: la Mac del taller es
+# una MacBook Air de 2017, con Intel. Una app x64 además corre en las Mac con
+# chip M por Rosetta, así que de las dos ésta es la que sirve en las dos; al
+# revés no. El día que haya una Mac con chip M y el plano grande se arrastre,
+# el cambio es la variable ARQ de aquí abajo y la de `package.json`.
+#
+# POR QUÉ NO SE FIJAN LAS VERSIONES DE LOS PAQUETES
+#
+# Se instalan sin fijar, igual que hace el flujo con el entorno de pruebas. La
+# red de seguridad no es la lista de versiones: es que la suite completa corre
+# sobre macOS en el mismo armado. Si una versión nueva rompe algo, sale ahí y
+# no en la máquina de Mike. Lo que SÍ se fija es la entrega del intérprete
+# (PBS_TAG), porque de ésa depende que el armado sea repetible.
+set -euo pipefail
+
+PBS_TAG="${PBS_TAG:-20261110}"
+PY="${PY_SERIE:-3.11}"
+ARQ="${ARQ:-x86_64-apple-darwin}"
+DESTINO="${DESTINO:-runtime/python}"
+
+echo "Python empotrado para macOS · serie $PY · $ARQ · entrega $PBS_TAG"
+
+API="https://api.github.com/repos/astral-sh/python-build-standalone/releases/tags/$PBS_TAG"
+curl -fsSL -o pbs.json "$API"
+
+# `install_only` es la variante sin los pedazos de compilación: trae bin/,
+# lib/ y nada más. Es la que se quiere dentro de una app.
+URL=$(python3 - <<'PY'
+import json, os, re, sys
+d = json.load(open("pbs.json"))
+pat = re.compile(rf"^cpython-{re.escape(os.environ['PY'])}\.\d+\+\d+-{re.escape(os.environ['ARQ'])}-install_only\.tar\.gz$")
+hits = sorted(a["name"] for a in d["assets"] if pat.match(a["name"]))
+if not hits:
+    print("NO ESTÁ. Lo que trae esta entrega para esa arquitectura:", file=sys.stderr)
+    for a in d["assets"]:
+        if os.environ["ARQ"] in a["name"] and "install_only" in a["name"]:
+            print("   ", a["name"], file=sys.stderr)
+    raise SystemExit(1)
+# El último por orden es el parche más nuevo de la serie.
+nombre = hits[-1]
+print(next(a["browser_download_url"] for a in d["assets"] if a["name"] == nombre))
+PY
+)
+export PY ARQ
+echo "  bajando: $URL"
+curl -fsSL -o python.tar.gz "$URL"
+
+# Se comprueba la huella publicada. Sin esto, un corte de red a medias deja un
+# tar truncado y el error aparece mucho después, al armar la app, diciendo
+# cualquier otra cosa.
+if curl -fsSL -o python.tar.gz.sha256 "$URL.sha256" 2>/dev/null; then
+  ESPERADA=$(cut -d' ' -f1 < python.tar.gz.sha256)
+  REAL=$(shasum -a 256 python.tar.gz | cut -d' ' -f1)
+  if [ "$ESPERADA" != "$REAL" ]; then
+    echo "!! la huella no cuadra: esperaba $ESPERADA y bajó $REAL"; exit 1
+  fi
+  echo "  huella sha256 correcta"
+else
+  echo "  (no hay .sha256 publicado para este archivo; se sigue sin comprobar)"
+fi
+
+rm -rf "$DESTINO"
+mkdir -p "$(dirname "$DESTINO")"
+tar -xzf python.tar.gz
+mv python "$DESTINO"
+
+BIN="$DESTINO/bin/python3"
+test -x "$BIN" || { echo "!! no quedó $BIN. Esto se extrajo:"; find "$DESTINO" -maxdepth 2 | head -20; exit 1; }
+echo "  intérprete: $("$BIN" -V)"
+
+# Los paquetes del motor. La lista sale de los imports de lo que viaja dentro
+# del paquete (core/, export/, server.py); numpy y fonttools entran solos como
+# dependencias de ezdxf y reportlab.
+"$BIN" -m pip install --quiet --upgrade pip
+"$BIN" -m pip install --quiet \
+  ezdxf fastapi uvicorn pydantic pillow reportlab orjson pypdfium2
+
+# Adelgazar. Un .app de 130 MB ya es grande; no hay por qué cargar además las
+# pruebas de la biblioteca estándar ni los .pyc de instalación.
+find "$DESTINO" -depth -type d -name "__pycache__" -exec rm -rf {} + 2>/dev/null || true
+find "$DESTINO" -depth -type d -name "test" -path "*/lib/python*/test" -exec rm -rf {} + 2>/dev/null || true
+find "$DESTINO" -depth -type d -name "idlelib" -exec rm -rf {} + 2>/dev/null || true
+find "$DESTINO" -depth -type d -name "tkinter" -exec rm -rf {} + 2>/dev/null || true
+
+# Que de verdad importe todo, aquí y no en la Mac de Mike. Si un wheel bajó
+# para la arquitectura equivocada, es en esta línea donde se ve.
+"$BIN" - <<'PY'
+import platform, sys
+import ezdxf, fastapi, uvicorn, pydantic, PIL, reportlab, orjson, pypdfium2, numpy
+print(f"  comprobado en {platform.machine()} · python {sys.version.split()[0]}")
+for m in (ezdxf, fastapi, pydantic, PIL, reportlab, numpy):
+    print(f"    {m.__name__:12s} {getattr(m, '__version__', '?')}")
+PY
+
+echo "  tamaño: $(du -sh "$DESTINO" | cut -f1)"

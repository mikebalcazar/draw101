+  /* La barra de progreso de la descarga  ·  0.20.12. Mike (16-sep-2026):
+   * «hay que hacer una barrita de progreso de cuando se está descargando la
+   * nueva versión». Antes sólo había un renglón de texto que se reescribía.
+   * Va fija arriba, con la misma pinta del letrero de versión nueva: título,
+   * barra, y debajo los megas y el porcentaje. Mientras no se sepa el total
+   * (algunos servidores no lo dicen) la barra corre sola de un lado a otro,
+   * que es la forma honesta de decir «esto avanza pero no sé cuánto falta».
+   * Se cierra sola al terminar. */
+  const Barra = (() => {
+    let caja = null, relleno = null, tit = null, izq = null, der = null;
+
+    function armar() {
+      if (caja) return;
+      caja = document.createElement("div");
+      caja.id = "barra-descarga";
+      tit = document.createElement("div");
+      tit.className = "tit";
+      const riel = document.createElement("div");
+      riel.className = "riel";
+      relleno = document.createElement("div");
+      relleno.className = "relleno";
+      riel.appendChild(relleno);
+      const pie = document.createElement("div");
+      pie.className = "pie";
+      izq = document.createElement("span");
+      der = document.createElement("span");
+      pie.append(izq, der);
+      caja.append(tit, riel, pie);
+      document.body.appendChild(caja);
+    }
+
+    /** `pct` null = no se sabe cuánto falta (barra corriendo). */
+    function mostrar({ titulo, pct = null, ya = 0, total = 0, estado = "" }) {
+      armar();
+      caja.classList.add("si");
+      caja.classList.toggle("indet", pct === null);
+      caja.classList.toggle("fin", estado === "listo");
+      caja.classList.toggle("mal", estado === "error");
+      tit.textContent = titulo;
+      if (pct !== null) relleno.style.width = `${Math.max(0, Math.min(100, pct))}%`;
+      izq.textContent = total ? `${(ya / 1e6).toFixed(1)} de ${(total / 1e6).toFixed(0)} MB`
+                              : (ya ? `${(ya / 1e6).toFixed(1)} MB` : "");
+      der.textContent = pct === null ? "" : `${Math.round(pct)} %`;
+    }
+
+    function cerrar(ms = 0) {
+      if (!caja) return;
+      if (ms) setTimeout(() => caja.classList.remove("si"), ms);
+      else caja.classList.remove("si");
+    }
+
+    return { mostrar, cerrar };
+  })();

+/* Barra de progreso de la descarga (Actualizar.Barra)  ·  0.20.12.
+ * Arriba, centrada, con la misma pinta del letrero de versión nueva. La barra
+ * tiene un brillo que la recorre mientras baja; al terminar se pone verde, y
+ * si falla, roja. Con «indet» (no se sabe el total) el relleno corre solo. */
+#barra-descarga{position:fixed;left:50%;top:14px;transform:translateX(-50%) translateY(-8px);
+  z-index:57;width:min(420px,86%);padding:12px 16px 11px;opacity:0;pointer-events:none;
+  background:var(--panel);border:1px solid var(--linea);border-left:3px solid var(--acc2);
+  border-radius:var(--r);box-shadow:0 8px 26px var(--sombra);
+  transition:opacity .18s ease,transform .18s ease}
+#barra-descarga.si{opacity:1;transform:translateX(-50%) translateY(0)}
+#barra-descarga .tit{font-size:12.5px;color:var(--txt);margin-bottom:8px}
+#barra-descarga .riel{height:6px;border-radius:999px;background:var(--panel3);
+  border:1px solid var(--linea2);overflow:hidden}
+#barra-descarga .relleno{height:100%;width:0;border-radius:999px;
+  background:linear-gradient(90deg,var(--acc),var(--acc2));
+  transition:width .25s ease;position:relative}
+#barra-descarga .relleno::after{content:"";position:absolute;inset:0;
+  background:linear-gradient(90deg,transparent,rgba(255,255,255,.45),transparent);
+  transform:translateX(-100%);animation:barra-brillo 1.4s ease-in-out infinite}
+#barra-descarga.indet .relleno{width:34%;animation:barra-corre 1.2s ease-in-out infinite}
+#barra-descarga.indet .relleno::after{animation:none}
+#barra-descarga .pie{display:flex;justify-content:space-between;margin-top:7px;
+  font-size:11px;color:var(--txt3);font-variant-numeric:tabular-nums}
+#barra-descarga.fin{border-left-color:var(--ok)}
+#barra-descarga.fin .relleno{background:var(--ok)}
+#barra-descarga.fin .relleno::after{animation:none}
+#barra-descarga.mal{border-left-color:var(--peligro)}
+#barra-descarga.mal .relleno{background:var(--peligro)}
+#barra-descarga.mal .relleno::after{animation:none}
+@keyframes barra-brillo{0%{transform:translateX(-100%)}60%,100%{transform:translateX(220%)}}
+@keyframes barra-corre{0%{margin-left:-34%}100%{margin-left:100%}}
+@media (prefers-reduced-motion: reduce){
+  #barra-descarga .relleno::after,#barra-descarga.indet .relleno{animation:none}
+}

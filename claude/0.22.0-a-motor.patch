+"""El token del documento, y de ahí para arriba la nube.
+
+Mike, 29-sep-2026: «tener alguna manera de identificar el archivo con un string
+o un token y que cada archivo tenga su token, así cuando se abre aunque sea
+otra compu, si el token y la cuenta de la licencia es la misma, ese archivo se
+sincroniza».
+
+POR QUÉ EL TOKEN VA DENTRO DEL ARCHIVO Y NO EN SU RUTA: porque la ruta es lo
+único que de verdad cambia. El mismo plano vive en `D:\\Proyectos\\Cocina Ruiz`
+en una máquina y en el escritorio en otra; se renombra, se mueve, se copia a
+una memoria. Un identificador que viva en el nombre o en la carpeta se rompe
+la primera vez que alguien ordena sus archivos. Dentro del `.t101d` viaja con
+él a donde vaya.
+
+QUÉ ES: un ULID. Veintiséis letras del alfabeto de Crockford —sin I, L, O ni U,
+que por teléfono y a mano se confunden—, con los primeros diez caracteres
+sacados del reloj. Eso le da dos cosas que hacen falta: se genera sin
+preguntarle a nadie (o sea, sin internet), y ordena por fecha de creación con
+sólo mirarlo.
+"""
+
+from __future__ import annotations
+
+import os
+import time
+
+# El alfabeto de Crockford, el mismo que usa el servidor para validar.
+_ABC = "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
+LARGO = 26
+
+
+def token_nuevo(ms: float | None = None) -> str:
+    """Un ULID. Los primeros 10 caracteres son el reloj; los 16 restantes, azar."""
+    t = int((time.time() if ms is None else ms) * 1000)
+    letras = []
+    for _ in range(10):
+        t, r = divmod(t, 32)
+        letras.append(_ABC[r])
+    tiempo = "".join(reversed(letras))
+    azar = "".join(_ABC[b % 32] for b in os.urandom(16))
+    return tiempo + azar
+
+
+def token_valido(v: object) -> bool:
+    """Si esto es un token de documento y no cualquier cosa.
+
+    Se comprueba ANTES de mandarlo al servidor y al leerlo de un archivo: un
+    `.t101d` editado a mano, o de una versión futura, no debe hacer que la app
+    mande basura ni que se caiga.
+    """
+    return isinstance(v, str) and len(v) == LARGO and all(c in _ABC for c in v)

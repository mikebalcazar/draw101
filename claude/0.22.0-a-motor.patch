+@app.post("/api/token-nuevo")
+def token_nuevo():
+    """Le estrena token al documento abierto, para «abrir como documento nuevo».
+
+    Es una de las tres salidas que Mike pidió cuando la copia de la nube es más
+    nueva que la de esta computadora: usar la de la nube, quedarse con ésta, o
+    abrir ésta como un documento aparte que no le haga nada a la otra. Esta
+    última es la que necesita un token nuevo, porque es lo único que distingue
+    un archivo de otro allá.
+
+    Y es la que se usa —sin preguntar— cuando el archivo llegó de otra cuenta:
+    «si llega a compartir ese archivo (por mail o por memoria) y lo abre otra
+    cuenta, esa otra cuenta genera un nuevo archivo con su propio token».
+
+    Marca el documento como sucio a propósito: el token vive en el archivo, así
+    que hasta que no se guarde, en el disco sigue el de antes. Que la app diga
+    que hay cambios sin guardar es verdad, y no un efecto raro.
+    """
+    with S.candado:
+        S.doc.token = mod_nube.token_nuevo()
+        S.doc.sucio = True
+        return {"token": S.doc.token, "resumen": S.resumen()}
+
+

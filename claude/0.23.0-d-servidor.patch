+class Copiar(BaseModel):
+    ids: list[str]
+
+
+@app.post("/api/copiar-portapapeles")
+def copiar_portapapeles(entrada: Copiar):
+    """Lo seleccionado, para los DOS destinos, en UN SOLO TEXTO  ·  6-oct-2026.
+
+    Mike: «copiar bloques y líneas y trazos y que se vayan en el portapapeles
+    para pegarlos en otro documento de draw o en algún programa que lea
+    vectores». Son dos destinos con necesidades opuestas:
+
+      · Illustrator, Inkscape, Figma o Word quieren vectores. Un SVG no sabe lo
+        que es una cota: la vuelve rayas y un texto suelto. Para allá está bien.
+      · Otro draw101 quiere las entidades como son, con sus capas y las
+        definiciones de los bloques que usan, para que la cota siga siendo una
+        cota y el bloque siga siendo un bloque.
+
+    Y VAN EN UN SOLO TEXTO, no en dos: el SVG, con el formato propio escondido
+    en `<metadata id="draw101">`, que el estándar manda ignorar. Dos textos
+    distintos en el portapapeles se pueden desincronizar y hay que pelearse con
+    los formatos a medida de cada sistema operativo; uno solo, no.
+    """
+    with S.candado:
+        ids = [i for i in entrada.ids if i in S.doc.entidades]
+        if not ids:
+            _error(ValueError("No hay nada seleccionado que se pueda copiar"))
+        copiadas = [S.doc.entidades[i] for i in ids]
+
+        from core import svg as mod_svg
+        carga = mod_svg.carga_de_seleccion(S.doc, ids)
+        try:
+            svg = mod_svg.seleccion_svg(S.doc, ids, carga)
+        except Exception as exc:
+            _error(exc)
+    # Un solo texto: el SVG, con el formato propio escondido dentro. Ver
+    # `core/svg.seleccion_svg`.
+    return {"svg": svg, "entidades": len(copiadas), "bloques": len(carga["bloques"])}
+
+
+class Pegar(BaseModel):
+    texto: str
+
+
+@app.post("/api/pegar-portapapeles")
+def pegar_portapapeles(entrada: Pegar):
+    """Pega lo que venía de otro draw101, en el sitio en que se copió."""
+    from core import svg as mod_svg
+    c = mod_svg.carga_de(entrada.texto or "")
+    if not c:
+        _error(ValueError("Lo que hay en el portapapeles no viene de draw101"))
+    try:
+        otro = Documento()
+        otro.unidades = c.get("unidades") if c.get("unidades") in ("mm", "cm", "m") else "mm"
+        for d in c.get("capas") or []:
+            otro.capas[d["nombre"]] = mod_capas.Capa.de_dict(d)
+        for d in c.get("bloques") or []:
+            otro.bloques[d["nombre"]] = ent_mod.Bloque.de_dict(d)
+        for d in c.get("entidades") or []:
+            e = ent_mod.de_dict(d)
+            otro.entidades[e.id] = e
+    except Exception as exc:
+        _error(ValueError(f"El portapapeles trae algo que no se pudo leer: {exc}"))
+
+    with S.candado:
+        antes = set(S.doc.entidades)
+        with S.doc.transaccion("Pegar"):
+            r = mod_importar.suelto(S.doc, otro, "portapapeles", "pegado")
+        # SE PEGA EN SU SITIO, con las mismas coordenadas con que se copió, y se
+        # devuelven los ids para que la interfaz las deje seleccionadas. Colocar
+        # con el ratón es el comando MOVER, que ya existe: mover entidades vive
+        # en la interfaz (ver `transformarSeleccion` en ui/editar.js), no aquí,
+        # y una segunda implementación en el motor sería otra geometría que
+        # mantener y otro lugar donde los arcos y las elipses salen mal.
+        r["ids"] = [i for i in S.doc.entidades if i not in antes]
+    return {**r, **S.resumen()}
+

+class ImportarPlano(BaseModel):
+    ruta: str
+    como: str = "bloque"          # "bloque" | "suelto"
+
+
+@app.post("/api/importar-plano")
+def importar_plano(entrada: ImportarPlano):
+    """Trae OTRO plano al dibujo abierto  ·  ver core/importar.py.
+
+    Con `como="bloque"` sólo se DEFINE el bloque y se devuelve su nombre: quien
+    lo coloca es el comando INSERTAR, que ya existe y ya está medido. Un segundo
+    camino para colocar sería otro lugar donde olvidar el encuadre o el
+    historial.
+    """
+    ruta = pathlib.Path(entrada.ruta)
+    if not ruta.exists():
+        _error(FileNotFoundError(f"No existe {ruta}"), 404)
+    if entrada.como not in ("bloque", "suelto"):
+        _error(ValueError("Sólo se puede importar «bloque» o «suelto»"))
+    try:
+        if ruta.suffix.lower() == config.EXT_PROYECTO:
+            otro = proyecto.abrir(ruta)
+        else:
+            otro, _informe = leer(ruta)
+    except Exception as exc:
+        if isinstance(exc, DWGNoDisponible):
+            _error(exc, 501)
+        _error(exc)
+
+    marca = f"importado:{ruta.name}"
+    try:
+        with S.candado:
+            # Un solo paso del historial: Ctrl+Z deshace la importación entera.
+            # Traer trescientas entidades y que cada una sea un paso sería
+            # dejar a alguien picando Ctrl+Z trescientas veces.
+            with S.doc.transaccion(f"Importar «{ruta.stem}»"):
+                if entrada.como == "bloque":
+                    r = mod_importar.como_bloque(S.doc, otro, ruta.stem, marca)
+                else:
+                    r = mod_importar.suelto(S.doc, otro, ruta.stem, marca)
+    except Exception as exc:
+        _error(exc)
+    return {**r, **S.resumen()}
+

+
+/* === IMPRIMIR UNA VENTANA DEL MODELO  ·  0.24.0 ============================
+ *
+ * Mike, 6-oct-2026: «quiero poder imprimir directo una ventana de la pantalla
+ * de model. Que cuando le de Ctrl+P me abra un diálogo de seleccionar la
+ * ventana. Pueda trazar una ventana del área que quiero imprimir y al dar enter
+ * me abra un preview de cómo queda en el tamaño de hoja seleccionado para
+ * mandar a imprimir».
+ *
+ * QUÉ PASABA ANTES. Ctrl+P en el modelo contestaba «no hay ninguna hoja que
+ * imprimir, crea una con PLANO». Para sacar un pedazo del dibujo había que
+ * hacer una hoja, ponerle una ventana, acomodarla a ojo, imprimir, y luego
+ * decidir si la hoja se queda estorbando en las pestañas o se borra. Cinco
+ * pasos y un archivo más sucio para imprimir una cosa y ya.
+ *
+ * LA HOJA NO SE GUARDA EN NINGUNA PARTE: se arma en el motor, se dibuja, se
+ * imprime y se tira (ver `core/papel.hoja_de_ventana` y /api/imprimir-ventana).
+ * Imprimir no modifica el dibujo.
+ *
+ * LLENA LA HOJA, y por eso el rótulo dice S/E. Lo escogió Mike con botones; la
+ * razón de no escribir «1:N» cuando la escala salió un número cualquiera está
+ * en core/papel.py, y es suya: «un plano que dice 1:20 y no lo está es peor que
+ * uno que no dice escala; el primero se mide con escalímetro y sale mal». Pero
+ * la escala de verdad SÍ se enseña en el pie de la vista previa: que no se
+ * pueda medir con escalímetro no quiere decir que haya que esconderla.
+ *
+ * Y SE PUEDE VOLVER A TRAZAR SIN CANCELAR. El primer rectángulo casi nunca
+ * queda. Después de trazarlo, Enter abre la vista previa —con las palabras de
+ * Mike: «al dar enter me abra un preview»— y R vuelve a pedir las esquinas,
+ * sin tener que empezar otra vez desde el cuadro de la hoja.
+ */
+Papel.imprimirVentanaDelModelo = async function () {
+  const en = (typeof Idioma !== "undefined" && Idioma.ingles);
+
+  // 1 · El cuadro: hoja e impresora. LA HOJA ES EL PAPEL aquí, así que no hay
+  //     dos tamaños que puedan contradecirse como en una hoja de verdad (donde
+  //     se puede dibujar un A1 y mandarlo a un papel carta).
+  const hojas = Object.entries(Papel.PAPELES).map(([k, p]) => [k, p.et]);
+  const prefs = estado.prefs || {};
+  const v = await Dialogo.abrir({
+    titulo: en ? "Print a window of the model" : "Imprimir una ventana del modelo",
+    pista: en
+      ? "Then draw the area you want. It fills the sheet, so the title block says S/E."
+      : "Luego traza sobre el dibujo el área que quieres. Llena la hoja, así que el rótulo dice S/E.",
+    campos: [
+      { clave: "formato", etiqueta: en ? "Sheet" : "Hoja", tipo: "lista",
+        valor: hojas.some((h) => h[0] === prefs.papel) ? prefs.papel : "A3",
+        opciones: hojas },
+      { clave: "impresora", etiqueta: en ? "Printer" : "Impresora", tipo: "texto",
+        valor: prefs.impresora || "" },
+    ],
+    aceptar: en ? "Draw the window" : "Trazar la ventana",
+  });
+  if (!v) return Comandos.eco(en ? "Cancelled." : "Cancelado.");
+
+  const formato = v.formato;
+  const impresora = (v.impresora || "").trim();
+
+  // Escape llega como una excepción «cancelado» (ver ui/entrada.js). Se atrapa
+  // aquí y no con el `repetir` de ui/dibujar.js: ése es de las herramientas de
+  // dibujo y repite para siempre, y esto termina cuando se imprime.
+  try {
+    for (;;) {
+      const a = await Entrada.pedirPunto({
+        mensaje: en ? "First corner of the area to print"
+                    : "Primera esquina del área a imprimir" });
+      const b = await Entrada.pedirPunto({
+        mensaje: en ? "Opposite corner" : "Esquina opuesta", base: a,
+        hule: (q) => ({ tipo: "caja", a, b: q }),
+        dinamica: "xy",
+      });
+      if (Math.abs(b[0] - a[0]) < 1e-9 || Math.abs(b[1] - a[1]) < 1e-9) {
+        Comandos.eco(en ? "That window has no area. Draw it again."
+                        : "Esa ventana no tiene área. Vuelve a trazarla.", "malo");
+        continue;
+      }
+
+      // «al dar enter me abra un preview», con sus palabras. Y R para volver a
+      // trazar: el primer rectángulo casi nunca queda, y obligar a empezar
+      // desde el cuadro por correrse dos centímetros sería de lo más molesto.
+      const resp = String(await Entrada.pedirTexto({
+        mensaje: en ? "Enter for the preview (R to draw it again)"
+                    : "Enter para la vista previa (R para volver a trazar)",
+        valor: "", opciones: ["R", "P"],
+      }) || "").toUpperCase();
+      if (resp.startsWith("R")) continue;
+
+      let r;
+      try {
+        r = await post("/api/imprimir-ventana",
+                       { x1: a[0], y1: a[1], x2: b[0], y2: b[1], formato });
+      } catch (e) { return avisar(e.message, true, 9000); }
+
+      // La escala de verdad, dicha en voz alta. Que no se pueda medir con
+      // escalímetro no quiere decir que haya que esconderla.
+      const comoQueda = `1:${r.escala < 10 ? r.escala.toFixed(1) : Math.round(r.escala)}`;
+      const cual = (Papel.PAPELES[formato] || {}).et || formato;
+      Comandos.eco(en
+        ? `${cual}${r.vertical ? " portrait" : ""} · fills the sheet at ${comoQueda} (S/E).`
+        : `${cual}${r.vertical ? " vertical" : ""} · llena la hoja a ${comoQueda} (S/E).`, "bien");
+
+      await Papel.vistaPrevia({
+        papel: formato, impresora,
+        hojas: [{ ancho: r.ancho, alto: r.alto, svg: r.svg }],
+        detalle: en
+          ? `Fills the sheet: it lands at ${comoQueda}, so the title block says S/E.`
+          : `Llena la hoja: queda a ${comoQueda}, por eso el rótulo dice S/E.`,
+      });
+      return;
+    }
+  } catch (err) {
+    if (err && err.message === "cancelado") return Comandos.eco(en ? "Cancelled." : "Cancelado.");
+    throw err;
+  }
+};
+
+Comandos.registrar({
+  nombre: "IMPRIMIRVENTANA", alias: ["IV", "PLOTVENTANA"],
+  ayuda: "Traza un área del modelo y la imprime en la hoja que escojas (Ctrl+P)",
+  correr: async () => Papel.imprimirVentanaDelModelo(),
+});

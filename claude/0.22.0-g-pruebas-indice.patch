@@ -0,0 +1,111 @@
+"""t049 · El índice de la nube: bajarlo al arrancar sin estorbarle a nadie.
+
+Mike pidió que draw101 baje al arrancar la lista de lo que hay en la nube, «sólo
+la lista o directorio, no los archivos en sí», para poder buscar entre ellos sin
+bajar nada. Eso es `electron/nube.js`, que junta el cifrado (medido en t048) con
+lo de esta app: dónde vive la licencia, cuál es la API y qué se guarda aquí.
+
+Vive en JavaScript porque el cifrado vive ahí (Node trae AES-256-GCM y la
+biblioteca estándar de Python no), así que se mide corriendo node desde aquí,
+igual que t036 con la puerta de licencia y t048 con el cifrado.
+
+LO QUE SE VIGILA, y por qué eso:
+
+  · **Que el índice se pida DESPUÉS de que la ventana ya se ve, nunca antes.**
+    Es la trampa de todo esto: pedirlo en el arranque es lo natural de escribir
+    y convierte un servidor lento o un wifi de hotel en un draw101 que tarda en
+    abrir. Un buscador que tarda diez segundos en tener datos se aguanta; una
+    app que no abre, no. Se revisa leyendo main.js, porque es ahí donde alguien
+    lo movería «para que esté listo antes».
+
+  · **Que sin internet siga saliendo la lista de la última vez**, marcada como
+    de la última vez. Lo fácil es devolver una lista vacía cuando falla la red,
+    y una lista vacía se lee como «se perdieron mis archivos».
+
+  · **Que «todavía no he podido preguntar» no se confunda con «no tienes
+    archivos»**, que son dos cosas distintas y la pantalla tiene que poder decir
+    cuál es.
+
+  · **Que al prender la nube NO se rastree el disco.** Mike fue explícito: «si
+    lo tenías desactivado y lo activas, sólo se irá subiendo conforme vayas
+    abriendo archivos, no se suben los que ya existen en tu compu si nunca los
+    abres». En una máquina con años de planos, lo contrario son miles de
+    subidas que nadie pidió. Se mide espiando `fs`, no contando peticiones de
+    red: la primera versión de esa comprobación contaba red y pasaba igual con
+    un rastreo del disco metido a propósito.
+
+Las comprobaciones de nube-indice.mjs se verificaron rompiendo el código: al
+devolver lista vacía cuando falla la red fallan tres; al confundir «todavía no»
+con «no hay», una; y al listar una carpeta al prender, la del disco.
+"""
+
+from __future__ import annotations
+
+import pathlib
+import re
+import shutil
+import subprocess
+
+from pruebas import comun
+
+DESCRIPCION = "el índice de la nube: se baja al arrancar, y sin internet sigue habiendo lista"
+
+RAIZ = pathlib.Path(__file__).resolve().parent.parent
+
+MINIMO = 39
+
+
+def correr(r: comun.Reporte) -> None:
+    _donde_se_pide(r)
+    _corre_node(r)
+
+
+def _donde_se_pide(r: comun.Reporte) -> None:
+    """El índice se pide con la ventana ya en pantalla, no antes.
+
+    Esto se lee del código porque es una decisión que se deshace sola: mover la
+    llamada al arranque «para que esté listo antes» se ve como una mejora y es
+    lo que hace que la app tarde en abrir.
+    """
+    main = (RAIZ / "electron" / "main.js").read_text(encoding="utf-8")
+
+    r.cierto("bajarIndice()" in main, "main.js pide el índice de la nube")
+
+    # Tiene que estar dentro de un gancho de la ventana ya cargada, y NO en el
+    # whenReady de arranque.
+    tras_la_ventana = re.search(
+        r'did-finish-load[^\n]*\n(?:.*\n){0,12}?.*nube\.bajarIndice\(\)', main)
+    r.cierto(tras_la_ventana is not None,
+             "y lo pide cuando la ventana ya cargó (did-finish-load), no antes")
+
+    # Y sin `await`: esperarla sería frenar el arranque aunque se pida tarde.
+    r.cierto("await nube.bajarIndice" not in main,
+             "sin esperarla: la app no se detiene a que conteste el servidor")
+
+    arranque = main[main.find("app.whenReady"):]
+    r.cierto("bajarIndice" not in arranque,
+             "y NO está en el arranque, que es donde alguien la movería «para que esté lista antes»")
+
+    # El .catch es lo que impide que un error de red se vuelva un error de la
+    # app en una promesa que nadie atrapó.
+    r.cierto(re.search(r'bajarIndice\(\)[\s\S]{0,400}?\.catch\(', main) is not None,
+             "y si falla, se calla: la nube nunca tira la app")
+
+
+def _corre_node(r: comun.Reporte) -> None:
+    prueba = RAIZ / "pruebas" / "nube-indice.mjs"
+    if not prueba.exists():
+        r.cierto(False, "pruebas/nube-indice.mjs debería existir: es lo que mide el índice")
+        return
+    node = shutil.which("node")
+    if not node:
+        r.cierto(True, "sin node no se puede medir el índice: se salta")
+        return
+
+    salida = subprocess.run([node, str(prueba)], cwd=str(RAIZ),
+                            capture_output=True, text=True, timeout=180)
+    cuantas = salida.stdout.count("  ok   ")
+    r.cierto(salida.returncode == 0,
+             f"el índice de la nube pasa sus {MINIMO} comprobaciones",
+             (salida.stdout + salida.stderr)[-600:])
+    r.cierto(cuantas >= MINIMO, f"y se corrieron todas ({cuantas} comprobaciones)")
# fin del parche: el renglon de cola absorbe el recorte del conector.

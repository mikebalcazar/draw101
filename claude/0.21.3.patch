+"""t039 · La altura de letra de fábrica, y que la previa mida lo mismo.
+
+Mike (24-sep-2026): «the text default size is too small. I had to change it
+to 3. Can we make 3 the default text size?»
+
+Los 3 son **centímetros**: un dibujo nuevo va en cm desde la 0.20.1. El cuadro
+de TEXTO ofrecía 0.75, porque la altura de fábrica se guardaba en milímetros
+(7.5) y se dividía entre los 10 mm que mide un centímetro. Ahora son 30 mm, o
+sea 3 cm.
+
+Se guarda en milímetros a propósito, y no como un 3 pelón: así la letra mide
+lo mismo *de verdad* se dibuje en cm, en mm o en metros. Un 3 pelón valdría 3
+cm en un dibujo en cm y 3 mm en uno en mm — la misma letra, diez veces más
+chica, sólo por abrir un DXF ajeno.
+
+Y de paso: la previa que se ve pegada al cursor antes de escribir el texto
+usaba «7.5» en unidades del dibujo mientras el cuadro usaba 7.5 milímetros. En
+un dibujo en centímetros el fantasma salía diez veces más grande que la letra
+que aparecía después. Se ve raro y hace escoger mal la altura.
+"""
+
+from __future__ import annotations
+
+from pruebas import comun, navegador
+
+DESCRIPCION = "la letra de fábrica son 3 cm, y la previa mide lo mismo"
+
+
+def correr(r: comun.Reporte) -> None:
+    if not navegador.hay_navegador():
+        r.cierto(True, "(sin Playwright en esta máquina: la prueba se salta)")
+        return
+    with navegador.programa() as (pagina, base):
+        navegador.cerrar_inicio(pagina)
+        _de_fabrica(r, pagina, base)
+        _la_previa(r, pagina)
+        _lo_recordado_manda(r, pagina)
+        r.igual(pagina.errores, [], "sin errores de JavaScript")
+
+
+def _sin_memoria(pagina) -> None:
+    """Como una instalación recién hecha: sin altura recordada."""
+    pagina.evaluate("""() => {
+        estado.prefs = estado.prefs || {};
+        const u = Object.assign({}, estado.prefs.ultimos_valores || {});
+        delete u.altura_texto;
+        estado.prefs.ultimos_valores = u;
+    }""")
+
+
+def _abrir_texto(pagina):
+    navegador.comando(pagina, "TEXTO")
+    navegador.comando(pagina, "100,100")
+    pagina.wait_for_selector(".dlg", timeout=5000)
+    return pagina.evaluate(
+        "() => document.querySelector('.dlg [data-clave=altura]').value")
+
+
+def _de_fabrica(r: comun.Reporte, pagina, base) -> None:
+    r.igual(navegador.estado(base)["unidades"], "cm",
+            "un dibujo nuevo va en centímetros")
+
+    _sin_memoria(pagina)
+    altura = _abrir_texto(pagina)
+    r.igual(altura, "3", "y el cuadro de TEXTO ofrece 3 de altura, no 0.75")
+
+    sufijo = pagina.evaluate(
+        "() => { const f = document.querySelector('.dlg [data-fila=altura] .suf'); return f ? f.textContent : null; }")
+    r.igual(sufijo, "cm", "y dice en qué unidad son esos 3")
+    pagina.evaluate("() => { Dialogo.cerrar(null); }")
+    pagina.wait_for_timeout(200)
+
+    # Los 30 mm son físicos: en un dibujo en milímetros la letra mide lo mismo
+    # y por eso el número que se ofrece es otro. Es lo que evita que abrir un
+    # DXF ajeno cambie el tamaño de la letra.
+    en_mm = pagina.evaluate("""() => {
+        const antes = estado.resumen.mm_por_unidad;
+        estado.resumen.mm_por_unidad = 1;
+        const v = alturaTextoOmision();
+        estado.resumen.mm_por_unidad = antes;
+        return v;
+    }""")
+    r.casi(en_mm, 30.0, "en un dibujo en milímetros son 30: la misma letra", 1e-9)
+
+
+def _la_previa(r: comun.Reporte, pagina) -> None:
+    """El fantasma pegado al cursor mide lo que va a medir la letra."""
+    _sin_memoria(pagina)
+    pagina.evaluate("() => { encuadrarCaja(-200, -200, 600, 600); }")
+    pagina.wait_for_timeout(150)
+    navegador.comando(pagina, "TEXTO")
+    pagina.wait_for_timeout(300)
+    # Mover el cursor para que el hule se pinte.
+    pagina.evaluate("""() => {
+        const c = document.querySelector('#lienzo').getBoundingClientRect();
+        document.querySelector('#lienzo').dispatchEvent(new MouseEvent('mousemove',
+            { clientX: c.left + 300, clientY: c.top + 300, bubbles: true }));
+    }""")
+    pagina.wait_for_timeout(250)
+    alto = pagina.evaluate("""() => {
+        const f = ((estado.hule || {}).fantasma || []).find((x) => x.clase === 'texto');
+        return f ? f.altura : null;
+    }""")
+    r.exige(alto is not None, "antes de escribir se ve una previa del texto")
+    r.casi(alto, 3.0, "y mide 3, lo mismo que va a medir la letra (no 7.5)", 1e-9)
+    pagina.keyboard.press("Escape")
+    pagina.wait_for_timeout(200)
+
+
+def _lo_recordado_manda(r: comun.Reporte, pagina) -> None:
+    """Esto es de fábrica, no una imposición: lo último que se escribe manda."""
+    pagina.evaluate("""() => {
+        estado.prefs = estado.prefs || {};
+        estado.prefs.ultimos_valores = Object.assign(
+            {}, estado.prefs.ultimos_valores || {}, { altura_texto: 12 });
+    }""")
+    altura = _abrir_texto(pagina)
+    r.igual(altura, "12", "si ya escribiste otra altura, ésa manda sobre la de fábrica")
+    pagina.evaluate("() => { Dialogo.cerrar(null); }")
+    pagina.wait_for_timeout(200)

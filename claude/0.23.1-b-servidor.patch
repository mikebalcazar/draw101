+@app.post("/api/nube-devolver-al-guardado")
+def nube_devolver_al_guardado():
+    """Qué volver a subir para que la nube no se quede con lo que se tiró  ·  0.23.1
+
+    Mike lo escogió con botones el 6-oct-2026: «al salir sin guardar, devolver
+    la nube al último guardado».
+
+    EL PROBLEMA QUE RESUELVE. Desde 0.23.1 el autoguardado sube a la nube, así
+    que la copia de allá puede ser trabajo SIN guardar. Eso es lo que se quería
+    —si se muere la máquina, el trabajo está—, pero si el usuario sale con
+    «Salir sin guardar» está diciendo que esos cambios NO los quiere. Dejarlos
+    como la copia más nueva de la nube haría que la otra computadora los abriera
+    mañana como si fueran el archivo.
+
+    Así que se devuelve: se vuelve a subir el archivo guardado. Esto sólo dice
+    QUÉ subir; subirlo es de la interfaz, que es la que habla con la nube.
+
+    LA FECHA SALE DE DENTRO DEL ARCHIVO y no de memoria, a propósito: ver
+    `proyecto.meta_de`.
+
+    Sólo entran los dibujos que de verdad tienen algo que devolver: con archivo
+    en el disco, autoguardados en esta sesión (si no, la nube ya tiene el
+    guardado y no hay nada que hacer), y cuyo archivo del disco sea un guardado
+    de verdad y no otro autoguardado.
+    """
+    salida = []
+    for s_ in ESCRITORIO.sesiones:
+        if not s_.ruta or not getattr(s_.doc, "autoguardado", False):
+            continue
+        ruta = pathlib.Path(s_.ruta)
+        if not ruta.exists():
+            continue
+        meta = proyecto.meta_de(ruta)
+        if not meta or meta.get("autoguardado"):
+            continue
+        token = meta.get("token")
+        if not mod_nube.token_valido(token):
+            continue
+        salida.append({"ruta": str(ruta), "token": token, "nombre": ruta.name,
+                       "modificado": str(meta.get("guardado") or "")})
+    return {"devolver": salida}
 
 

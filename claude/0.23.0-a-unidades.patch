+def _encabezado_miente(doc, k: float):
+    """¿El tamaño del dibujo desmiente la unidad que declara el encabezado?
+
+    Hay archivos que dicen una unidad y están dibujados en otra. `ezdxf.new()`
+    sin más pone $INSUNITS = 6 (metros) aunque el dibujo esté en milímetros —lo
+    hacen nuestras propias pruebas—, y hacerle caso convertiría una línea de
+    1 000 mm en una de un kilómetro.
+
+    Un plano de arquitectura o de taller mide entre un centímetro y medio
+    kilómetro. Si con esa unidad el dibujo cae fuera de esa horquilla, el que
+    está mal es el encabezado. Devuelve la medida absurda, o None si cuadra.
+
+    Estaba dentro de `a_milimetros`; se sacó el 6-oct-2026 porque `adoptar`
+    necesita exactamente el mismo freno y copiarlo habría sido tener dos.
+    """
+    ext = doc.extension()
+    if not ext:
+        return None
+    mayor = max(ext[2] - ext[0], ext[3] - ext[1]) * k
+    if mayor > SENSATO_MAX or (mayor and mayor < SENSATO_MIN):
+        return mayor
+    return None
+
+
+def adoptar(doc, insunits: int | None) -> dict:
+    """EL DIBUJO SE QUEDA EN LA UNIDAD QUE DECLARA EL ARCHIVO  ·  6-oct-2026.
+
+    Mike: «¿Hay manera de leer en qué están las unidades del archivo a importar
+    —si metros o cm o pulgadas— y que draw iguale esa info? Que aplique las
+    unidades del plano iguales a como las traía el archivo».
+
+    QUÉ PASABA ANTES. draw101 convertía todo a milímetros al abrir. Un plano en
+    metros entraba multiplicado por mil: un muro de 10 m salía como 10 000. El
+    tamaño real era correcto —10 000 mm SON 10 m— pero el número que uno lee en
+    la cota, el que teclea y el que compara contra el plano del arquitecto, no
+    era el del archivo. Y como un dibujo nuevo nace en centímetros, la cosa se
+    sentía peor todavía: unos planos en cm y otros en mm, sin razón visible.
+
+    QUÉ PASA AHORA. Si el archivo declara milímetros, centímetros o metros —las
+    tres unidades en que draw101 sabe trabajar— el dibujo se pone en ESA unidad
+    y NO SE TOCA NI UNA COORDENADA. El muro de 10 m sigue diciendo 10. De paso,
+    al exportar se devuelve con el mismo $INSUNITS y los mismos números con que
+    llegó, que es lo que este módulo prometía desde el principio y no cumplía.
+
+    LO QUE NO CAMBIA. Las unidades en que draw101 **no** sabe trabajar
+    (pulgadas, pies, yardas…) siguen convirtiéndose a milímetros: no hay una
+    unidad de trabajo que las reciba, y dejar el dibujo en pulgadas mintiendo
+    que son milímetros sería mucho peor. Y el freno de mano sigue igual: si el
+    encabezado no cuadra con el tamaño del dibujo, no se le hace caso.
+    """
+    k = MM_POR_UNIDAD.get(insunits or 0)
+    if k is None:
+        return {"adoptado": None, "convertido": False,
+                "motivo": "unidad desconocida", "insunits": insunits}
+
+    absurda = _encabezado_miente(doc, k)
+    if absurda:
+        return {"adoptado": None, "convertido": False, "insunits": insunits,
+                "motivo": "el encabezado no cuadra con el tamaño del dibujo",
+                "unidad": NOMBRE.get(insunits, f"código {insunits}"),
+                "medida_absurda": absurda}
+
+    nombre = NOMBRE_POR_INSUNITS.get(insunits)
+    if not nombre:
+        # Pulgadas, pies, yardas…: no hay unidad de trabajo que las reciba.
+        return a_milimetros(doc, insunits)
+
+    if doc.unidades != nombre:
+        vieja = doc.unidades if doc.unidades in MM_POR_NOMBRE else "mm"
+        # `aplicar` y no `cambiar`: `cambiar` anota un paso en el historial, y
+        # abrir un archivo no es una acción que alguien pueda deshacer.
+        sucio = doc.sucio
+        aplicar(doc, vieja, nombre, escalar=False)
+        doc.sucio = sucio        # recién abierto no tiene cambios sin guardar
+    doc.factor_unidades = 1.0    # no hay nada que deshacer al exportar
+    return {"adoptado": nombre, "convertido": False, "insunits": insunits,
+            "unidad": NOMBRE.get(insunits, f"código {insunits}")}
+
+

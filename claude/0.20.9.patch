+/* --- Bajar un archivo con la red de Chromium  ·  0.20.9 ------------------
+ *
+ * Mike (15-sep-2026): el motor de Python no llega a GitHub en su máquina
+ * (SSL: CERTIFICATE_VERIFY_FAILED: el Python empotrado no ve las raíces de
+ * Windows), y la página tampoco pudo bajar el instalador (CORS en el sitio
+ * de los archivos de GitHub). El proceso principal sí: `net` usa la red de
+ * Chromium, con los certificados y el proxy de Windows, sigue redirecciones y
+ * no le aplica CORS. Se baja a la carpeta temporal y el motor lo comprueba
+ * y lo mueve (core/actualizar.recibir_ruta). */
+ipcMain.handle("bajar-archivo", async (e, url, nombre) => {
+  const { net } = require("electron");
+  const os = require("os");
+  const destino = path.join(os.tmpdir(), `draw101-${Date.now()}-${path.basename(nombre || "archivo.bin")}`);
+  await new Promise((resolver, rechazar) => {
+    const pedido = net.request({ url, redirect: "follow" });
+    pedido.on("response", (resp) => {
+      if (resp.statusCode < 200 || resp.statusCode >= 300) { rechazar(new Error(`HTTP ${resp.statusCode}`)); return; }
+      const total = parseInt(resp.headers["content-length"] || "0", 10) || 0;
+      let ya = 0, ultimo = 0;
+      const f = fs.createWriteStream(destino);
+      resp.on("data", (trozo) => {
+        f.write(trozo); ya += trozo.length;
+        if (Date.now() - ultimo > 300) { ultimo = Date.now(); try { e.sender.send("bajar-avance", { ya, total }); } catch (_) { /* ventana cerrada */ } }
+      });
+      resp.on("end", () => f.end(() => resolver()));
+      resp.on("error", rechazar);
+    });
+    pedido.on("error", rechazar);
+    pedido.end();
+  });
+  return destino;
+});
+

+def recibir_ruta(nombre: str, ruta: str) -> dict:
+    """El instalador bajado por Electron a una ruta temporal (misma comprobación
+    que `recibir_archivo`, sin pasar los bytes por HTTP)."""
+    ult = _ultima_revision["datos"]
+    if not ult:
+        raise ValueError("No sé qué versión es: primero hay que consultar el puntero.")
+    origen = pathlib.Path(ruta)
+    if not origen.is_file():
+        raise ValueError(f"No encuentro lo bajado: {ruta}")
+    nombre = pathlib.Path(nombre or ult["archivo"] or f"draw101-{ult['version']}-setup.exe").name
+    destino = _carpeta_descargas() / nombre
+    tam = origen.stat().st_size
+    if ult["bytes"] and tam != ult["bytes"]:
+        origen.unlink(missing_ok=True)
+        raise ValueError(f"Llegaron {tam} bytes y el sitio dice {ult['bytes']}: descarga incompleta.")
+    if ult["sha256"] and _sha256(origen) != ult["sha256"]:
+        origen.unlink(missing_ok=True)
+        raise ValueError("Lo bajado no cuadra con la huella que publica Taller 101. No se instala.")
+    destino.unlink(missing_ok=True)
+    try:
+        origen.replace(destino)
+    except OSError:
+        import shutil
+        shutil.move(str(origen), str(destino))
+    _poner("listo", 100, f"draw101 {ult['version']} bajado y comprobado. Listo para instalar.", ult["version"], str(destino))
+    return dict(_estado)
+

+function ladoDe(ent, p) {
+  if (ent.tipo === "linea") {
+    const dx = ent.p2[0] - ent.p1[0], dy = ent.p2[1] - ent.p1[1];
+    return Math.sign((p[0] - ent.p1[0]) * -dy + (p[1] - ent.p1[1]) * dx) || 1;
+  }
+  if (ent.tipo === "circulo" || ent.tipo === "arco") {
+    return Math.hypot(p[0] - ent.centro[0], p[1] - ent.centro[1]) > ent.radio ? 1 : -1;
+  }
+  if (ent.tipo === "polilinea") {
+    const prims = estado.geometria.filter((pr) => pr.id === ent.id && pr.tipo === "seg");
+    let mejor = null;
+    for (const pr of prims) {
+      const q = Osnap.sobre(pr, p);
+      const dd = Math.hypot(q[0] - p[0], q[1] - p[1]);
+      if (!mejor || dd < mejor.d) mejor = { pr, d: dd };

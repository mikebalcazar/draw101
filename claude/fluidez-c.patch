+# con la entidad exacta (tolerancia 1e-6) y se rompían (t007).
+
+
+def _segmentos_por_vuelta(r: float) -> int:
+    if r <= 0:
+        return MIN_SEG
+    c = 1 - FLECHA_MAX / r
+    if c <= -1:
+        return MIN_SEG
+    if c >= 1:
+        return SEGMENTOS
+    n = math.ceil(math.pi / math.acos(c))
+    return max(MIN_SEG, min(SEGMENTOS, n))
 
 

+def _decimales(doc: Documento) -> int:
+    """Cuántos decimales tiene sentido mandar al lienzo, en las unidades del
+    dibujo. El taller corta a **una centésima de milímetro**: más dígitos no se
+    ven, no se cortan y sí pesan. En el plano de Mike (16-sep-2026) las
+    coordenadas iban con 16 dígitos («86.32124944288067») y el JSON pesaba 50
+    MB; a dos decimales en mm, 38 MB. En metros salen 5 decimales, en cm 4 y
+    en mm 2: la precisión es la misma medida en el mundo real."""
+    mm_por_unidad = mod_unidades.MM_POR_NOMBRE.get(doc.unidades, 1.0)
+    return max(0, int(round(math.log10(mm_por_unidad * 100))))
+
+
+def redondear(trazos_: list[dict], dec: int) -> list[dict]:
+    """Deja las coordenadas de esos trazos con `dec` decimales. Se hace **una
+    vez por entidad**, antes de guardarla en la caché, no en cada envío."""
+    for t in trazos_:
+        p = t.get("puntos")
+        if p:
+            t["puntos"] = [[round(q[0], dec), round(q[1], dec)] if len(q) == 2
+                           else [round(q[0], dec), round(q[1], dec), *q[2:]] for q in p]
+        q = t.get("p")
+        if q is not None and len(q) >= 2:
+            t["p"] = [round(q[0], dec), round(q[1], dec), *q[2:]]
+    return trazos_

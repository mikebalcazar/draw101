@@ -128,10 +128,20 @@ def ventana_nueva(x, y, ancho, alto, centro, escala=20.0) -> dict:
 
     `escala` es el denominador: 20 significa 1:20, o sea que 20 mm de mueble
     ocupan 1 mm de papel.
+
+    `sin_escala` marca la ventana como **S/E**  ·  Mike, 29-sep-2026: «aparte
+    de las escalas disponibles, necesito una opción que diga sin escala donde
+    pueda acercar o alejar el zoom del viewport según requiera».
+
+    La escala SIGUE EXISTIENDO por dentro —es lo que convierte el modelo a
+    milímetros de papel y sin ella no hay nada que dibujar—; lo que cambia es
+    que deja de ser una de la lista y que el rótulo escribe «S/E» en vez de
+    «1:N». Un plano que dice 1:20 y no lo está es peor que uno que no dice
+    escala: el primero se mide con escalímetro y sale mal.
     """
     return {"x": float(x), "y": float(y), "ancho": float(ancho), "alto": float(alto),
             "centro": [float(centro[0]), float(centro[1])], "escala": float(escala),
-            "rotacion": 0.0, "marco": True}
+            "rotacion": 0.0, "marco": True, "sin_escala": False}
 
 
 # =========================================================================
@@ -336,9 +346,21 @@ def _rotulo(doc: Documento, layout: dict, ancho: float, alto: float,
 
 
 def _escala_principal(layout: dict) -> str:
+    """Lo que el rótulo escribe en ESCALA cuando nadie lo escribió a mano.
+
+    Una ventana marcada «sin escala» no aporta un número: aporta un «S/E».
+    Si TODAS lo están, eso es lo que dice el plano; si hay de las dos, dice
+    VARIAS, que es lo que ya decía cuando había escalas distintas —y es lo
+    honesto: el número de abajo no vale para todo el plano, hay que mirar
+    cada ventana.
+    """
     vs = layout.get("ventanas") or []
     if not vs:
         return "—"
+    if all(v.get("sin_escala") for v in vs):
+        return "S/E"
+    if any(v.get("sin_escala") for v in vs):
+        return "VARIAS"
     escalas = {v.get("escala", 20) for v in vs}
     if len(escalas) == 1:
         e = escalas.pop()

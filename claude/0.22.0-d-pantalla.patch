+++ b/ui/nube.js
@@ -0,0 +1,564 @@
+/* Mis archivos en la nube  ·  0.22.0
+ *
+ * La pantalla desde la que se busca y se abre lo que está en la nube. Mike la
+ * pidió así, con palabras suyas: «En la nube se guardan todos juntos, no hay
+ * carpetas ni nada. Si acaso búsqueda/orden por fecha creación, nombre, fecha
+ * modificación, frecuencia de uso».
+ *
+ * NO HAY CARPETAS, y eso no es una simplificación: es la decisión. Un taller no
+ * necesita un árbol de carpetas para cien planos, necesita encontrar «cocina
+ * Ruiz» escribiendo «ruiz». Por eso lo que hay es un buscador y cuatro órdenes.
+ *
+ * TODO PASA EN ESTA MÁQUINA. La lista ya viene con los nombres descifrados (el
+ * proceso principal los descifra al bajar el índice, ver electron/nube.js), así
+ * que buscar y ordenar es filtrar un arreglo, sin una sola petición al servidor
+ * por cada letra que se teclea. El servidor no sabe cómo se llama un plano ni
+ * qué se busca.
+ *
+ * Y LO QUE SE BAJA ES UN ARCHIVO, no el documento abierto. Bajar deja el plano
+ * en una carpeta aparte y lo abre desde ahí: nunca se escribe encima del
+ * archivo que alguien tiene abierto. Quién gana entre la copia de la nube y la
+ * de aquí lo decide el dibujante (ver el aviso de versiones), no esta pantalla.
+ */
+
+const Nube = (() => {
+  let caja = null;
+  let archivos = [];
+  let orden = "modificado";      // lo último tocado primero: es lo que se busca
+  let alReves = false;
+  let busca = "";
+  let estado = null;             // por qué la lista está como está
+  let ultimoFallo = null;        // por qué no se pudo abrir el último, sin depender del idioma
+
+  const T = () => (typeof Idioma !== "undefined" && Idioma.ingles);
+
+  const ORDENES = [
+    ["modificado", "Modificado", "Modified"],
+    ["creado", "Creado", "Created"],
+    ["nombre", "Nombre", "Name"],
+    ["aperturas", "Más usados", "Most used"],
+  ];
+
+  /* --- cómo se escribe cada cosa --------------------------------------- */
+
+  /** «hace 3 días», que es lo que se quiere saber de un plano. La fecha exacta
+   *  va en el `title`, para quien la necesite. */
+  function cuando(iso) {
+    if (!iso) return "—";
+    const d = new Date(iso);
+    if (isNaN(d)) return "—";
+    const seg = (Date.now() - d.getTime()) / 1000;
+    const en = T();
+    if (seg < 90) return en ? "just now" : "hace un momento";
+    const min = Math.round(seg / 60);
+    if (min < 60) return en ? `${min} min ago` : `hace ${min} min`;
+    const hrs = Math.round(min / 60);
+    if (hrs < 24) return en ? `${hrs} h ago` : `hace ${hrs} h`;
+    const dias = Math.round(hrs / 24);
+    if (dias < 31) return en ? `${dias} d ago` : `hace ${dias} d`;
+    return d.toLocaleDateString(en ? "en-US" : "es-MX", { year: "numeric", month: "short", day: "numeric" });
+  }
+
+  function pesa(bytes) {
+    const b = Number(bytes) || 0;
+    if (b < 1024) return `${b} B`;
+    if (b < 1024 * 1024) return `${Math.round(b / 1024)} KB`;
+    return `${(b / (1024 * 1024)).toFixed(1)} MB`;
+  }
+
+  const sinExt = (n) => String(n || "").replace(/\.t101d$/i, "");
+
+  /* --- buscar y ordenar, aquí ------------------------------------------ */
+
+  /** Sin acentos y en minúsculas: quien escribe «ramirez» tiene que encontrar
+   *  «Ramírez». Es el detalle que hace que un buscador se sienta roto.
+   *
+   *  Se usa la propiedad Unicode `Diacritic` y no un rango de códigos escrito a
+   *  mano, por dos razones: se lee —dice «los acentos» en vez de cuatro números
+   *  en hexadecimal— y, sobre todo, porque el chat que mantiene esto no puede
+   *  empujar por git y transcribe cada parche a mano. Los caracteres
+   *  combinantes son invisibles en el fuente, y una secuencia de escape se
+   *  convierte en ellos por el camino: las dos formas se perdieron en el
+   *  transporte antes de dar con ésta. */
+  const plano = (s) => String(s || "").toLowerCase()
+    .normalize("NFD").replace(/\p{Diacritic}/gu, "");
+
+  function filtradas() {
+    const q = plano(busca).trim();
+    let lista = archivos;
+    if (q) {
+      const partes = q.split(/\s+/);
+      // Todas las palabras, en cualquier orden: «ruiz cocina» encuentra
+      // «Cocina Ruiz». Buscar la frase entera no lo encontraría.
+      lista = lista.filter((a) => {
+        const n = plano(a.nombre);
+        return partes.every((p) => n.includes(p));
+      });
+    }
+    const mas = alReves ? -1 : 1;
+    const cmp = {
+      nombre: (a, b) => plano(a.nombre).localeCompare(plano(b.nombre)) * mas,
+      // En las fechas y el uso, lo más reciente y lo más usado va primero sin
+      // tener que invertir nada: es lo que alguien espera al escogerlo.
+      modificado: (a, b) => String(b.modificado || "").localeCompare(String(a.modificado || "")) * mas,
+      creado: (a, b) => String(b.creado || "").localeCompare(String(a.creado || "")) * mas,
+      aperturas: (a, b) => ((b.aperturas || 0) - (a.aperturas || 0)) * mas,
+    }[orden];
+    return [...lista].sort(cmp);
+  }
+
+  /* --- la pantalla ----------------------------------------------------- */
+
+  function cerrar() {
+    if (caja) { caja.remove(); caja = null; }
+    document.removeEventListener("keydown", alTeclear, true);
+  }
+
+  function alTeclear(e) {
+    if (!caja) return;
+    if (e.key === "Escape") { e.preventDefault(); e.stopPropagation(); cerrar(); }
+  }
+
+  async function abrir() {
+    if (!window.t101 || !window.t101.nube) {
+      avisar(T() ? "The cloud only works from the installed app."
+                 : "La nube sólo funciona desde la aplicación instalada.", true);
+      return;
+    }
+    cerrar();
+    busca = "";
+
+    // Lo guardado primero, para que la pantalla salga llena de inmediato, y la
+    // red después: nunca se espera a un servidor con la pantalla en blanco.
+    const ya = await window.t101.nube.indiceYa();
+    archivos = ya.archivos || [];
+    estado = ya;
+    pintar();
+
+    window.t101.nube.indiceBajar().then((r) => {
+      if (!caja) return;
+      archivos = r.archivos || archivos;
+      estado = r;
+      pintar();
+    }).catch(() => { /* lo guardado ya está en pantalla */ });
+  }
+
+  /** Qué decir cuando la lista no es lo que debería ser. Cada caso dice algo
+   *  distinto a propósito: «no tienes archivos» y «no pude preguntar» se ven
+   *  igual en pantalla si nadie los distingue, y no son lo mismo. */
+  function elAviso() {
+    const en = T();
+    if (!estado) return null;
+    if (estado.apagada) return { por: "apagada", texto: en
+      ? "The cloud is off for this computer. Turn it on in Settings."
+      : "La nube está apagada en esta computadora. Se prende en Ajustes." };
+    if (estado.sinLicencia) return { por: "sin_licencia", texto: en
+      ? "No licence on this computer, so the cloud can't be reached."
+      : "Esta computadora no tiene licencia, así que no se puede llegar a la nube." };
+    if (estado.todavia_no) return { por: "todavia_no", texto: en
+      ? "Haven't been able to ask the server yet."
+      : "Todavía no se ha podido preguntar al servidor." };
+    if (estado.sinRed) return { por: "sin_red", texto: en
+      ? "Couldn't reach the server. This is the list from last time."
+      : "No se pudo llegar al servidor. Ésta es la lista de la última vez." };
+    if (estado.error) return { por: "error",
+      texto: (en ? "The server said: " : "El servidor contestó: ") + estado.error };
+    return null;
+  }
+
+  function pintar() {
+    const en = T();
+    const primeraVez = !caja;
+    if (primeraVez) {
+      caja = document.createElement("div");
+      caja.className = "dlg nube";
+      caja.innerHTML = `
+        <div class="panel">
+          <div class="cab"><b></b></div>
+          <div class="nube-barra">
+            <input class="nube-busca" type="search" autocomplete="off">
+            <div class="nube-ordenes"></div>
+          </div>
+          <div class="nube-aviso" hidden></div>
+          <div class="cuerpo nube-lista"></div>
+          <div class="nube-pie"><button class="gh nube-cerrar"></button></div>
+        </div>`;
+      document.body.appendChild(caja);
+      // Un clic fuera del panel cierra; dentro, no.
+      caja.addEventListener("mousedown", (e) => { if (e.target === caja) cerrar(); });
+      document.addEventListener("keydown", alTeclear, true);
+
+      const campo = caja.querySelector(".nube-busca");
+      campo.addEventListener("input", () => { busca = campo.value; pintarLista(); });
+      setTimeout(() => campo.focus(), 0);
+    }
+
+    caja.querySelector(".cab b").textContent = en ? "My files in the cloud" : "Mis archivos en la nube";
+    caja.querySelector(".nube-busca").placeholder = en ? "Search by name…" : "Buscar por nombre…";
+    const bc = caja.querySelector(".nube-cerrar");
+    bc.textContent = en ? "Close" : "Cerrar";
+    bc.onclick = cerrar;
+
+    const bo = caja.querySelector(".nube-ordenes");
+    bo.innerHTML = "";
+    for (const [clave, es, ing] of ORDENES) {
+      const b = document.createElement("button");
+      b.className = "gh" + (orden === clave ? " puesto" : "");
+      // La clave va en un dato y no sólo en la etiqueta: el idioma de la app lo
+      // decide el motor, así que un botón se busca por lo que hace y no por
+      // cómo se llama hoy.
+      b.dataset.orden = clave;
+      b.textContent = (en ? ing : es) + (orden === clave && alReves ? " ↑" : "");
+      b.onclick = () => {
+        // Volver a picar el mismo orden lo invierte, que es lo que espera
+        // cualquiera que haya usado una tabla.
+        if (orden === clave) alReves = !alReves; else { orden = clave; alReves = false; }
+        pintar();
+      };
+      bo.appendChild(b);
+    }
+
+    const av = caja.querySelector(".nube-aviso");
+    const por = elAviso();
+    av.hidden = !por;
+    av.textContent = por ? por.texto : "";
+    // La razón, aparte de las palabras: es lo que se puede medir sin depender
+    // del idioma, y lo que sirve para saber POR QUÉ la lista está así.
+    if (por) av.dataset.por = por.por; else delete av.dataset.por;
+
+    pintarLista();
+  }
+
+  function pintarLista() {
+    if (!caja) return;
+    const en = T();
+    const lista = caja.querySelector(".nube-lista");
+    lista.innerHTML = "";
+    const filas = filtradas();
+
+    if (!filas.length) {
+      const v = document.createElement("div");
+      v.className = "nube-vacio";
+      v.textContent = busca
+        ? (en ? `Nothing matches “${busca}”.` : `Nada coincide con «${busca}».`)
+        : (en ? "No files in the cloud yet." : "Todavía no hay archivos en la nube.");
+      lista.appendChild(v);
+      return;
+    }
+
+    for (const a of filas) {
+      const f = document.createElement("div");
+      f.className = "nube-fila" + (a.ilegible ? " ilegible" : "");
+      const nom = document.createElement("div");
+      nom.className = "nube-nom";
+      // Un nombre que no se pudo descifrar se dice, y el renglón sigue ahí: se
+      // puede bajar y quitar igual. Perder la lista entera por un archivo raro
+      // sería cambiar un problema chico por uno grande.
+      nom.textContent = a.ilegible
+        ? (en ? "(unreadable name)" : "(nombre ilegible)")
+        : sinExt(a.nombre);
+      nom.title = a.ilegible ? a.token : a.nombre;
+
+      const dat = document.createElement("div");
+      dat.className = "nube-dat";
+      const cuantas = a.aperturas
+        ? ` · ${a.aperturas} ${en ? (a.aperturas === 1 ? "open" : "opens") : (a.aperturas === 1 ? "apertura" : "aperturas")}`
+        : "";
+      dat.textContent = `${cuando(a.modificado)} · ${pesa(a.bytes)}${cuantas}`;
+      dat.title = `${en ? "Modified" : "Modificado"}: ${a.modificado || "—"}\n`
+        + `${en ? "Created" : "Creado"}: ${a.creado || "—"}\n`
+        + `${en ? "Version" : "Versión"}: ${a.version ?? "—"}`;
+
+      const abrirB = document.createElement("button");
+      abrirB.className = "gh";
+      abrirB.textContent = en ? "Open" : "Abrir";
+      abrirB.onclick = () => bajarYAbrir(a);
+
+      f.append(nom, dat, abrirB);
+      // Doble clic en el renglón hace lo mismo que el botón.
+      f.ondblclick = () => bajarYAbrir(a);
+      lista.appendChild(f);
+    }
+  }
+
+  /* --- abrir uno ------------------------------------------------------- */
+
+  async function bajarYAbrir(a) {
+    const en = T();
+    ultimoFallo = null;
+    avisar((en ? "Downloading " : "Bajando ") + sinExt(a.nombre) + "…");
+    let r;
+    try { r = await window.t101.nube.bajar(a.token); }
+    catch (e) { r = { error: e.message }; }
+
+    if (!r || !r.ok) {
+      // Se dice QUÉ pasó. «No se pudo» a secas deja a alguien sin saber si es
+      // su internet, su licencia, o que el archivo ya no está.
+      const porque = r?.sinRed ? (en ? "couldn't reach the server" : "no se pudo llegar al servidor")
+        : r?.noEsta ? (en ? "it's no longer in the cloud" : "ya no está en la nube")
+        : r?.sinLicencia ? (en ? "this computer has no licence" : "esta computadora no tiene licencia")
+        : (r?.error || (en ? "unknown error" : "error desconocido"));
+      ultimoFallo = r?.sinRed ? "sin_red" : r?.noEsta ? "no_esta"
+        : r?.sinLicencia ? "sin_licencia" : "error";
+      avisar((en ? "Couldn't open it: " : "No se pudo abrir: ") + porque, true, 9000);
+      return;
+    }
+    cerrar();
+    // Se abre por la misma puerta que cualquier archivo, para que pase por lo
+    // mismo: preguntar si hay cambios sin guardar, las pestañas, el encuadre.
+    // Una puerta aparte para «los de la nube» sería otro camino que mantener y
+    // otro donde olvidar el «¿guardas antes de cerrar?».
+    try { await Archivo.abrir(r.ruta); }
+    catch (e) { avisar(e.message, true, 9000); }
+  }
+
+  return { abrir, cerrar, abierta: () => !!caja, _filtradas: filtradas,
+           get ultimoFallo() { return ultimoFallo; },
+           _poner: (l, o, b, rev) => { archivos = l; orden = o || orden; busca = b ?? busca; alReves = !!rev; } };
+})();
+
+Comandos.registrar({
+  nombre: "NUBE", alias: ["CLOUD", "MISARCHIVOS", "MYFILES"],
+  ayuda: "Mis archivos en la nube: buscarlos y abrirlos",
+  correr: () => Nube.abrir(),
+});
+
+window.Nube = Nube;
+
+/* --- Al abrir un archivo: quién gana  (paso 7, 0.22.0) ---
+ *
+ * Mike lo pidió así: «cuando lo abras en otra compu, al identificar te pregunte
+ * si quieres usar la versión más actual (de la nube) en este archivo, o quieres
+ * generar un nuevo documento?». Y para el caso de un archivo que llegó de
+ * fuera: «si llega a compartir ese archivo (por mail o por memoria) y lo abre
+ * otra cuenta, esa otra cuenta genera un nuevo archivo con su propio token».
+ *
+ * TRES SITUACIONES, y sólo UNA pregunta. Preguntar de más es lo que hace que la
+ * gente conteste sin leer, y este cuadro es justo el que no se debe contestar
+ * sin leer:
+ *
+ *   a) El token no está en la nube de esta cuenta → llegó de otra cuenta, o es
+ *      una copia hecha en el explorador de archivos. Se le estrena token SIN
+ *      PREGUNTAR y se dice en la barra. No hay nada que decidir: no existe una
+ *      «otra versión» con la que comparar.
+ *
+ *   b) Está, y la copia de la nube es más nueva → LA ÚNICA PREGUNTA, con las
+ *      tres salidas de Mike.
+ *
+ *   c) Está, y la de aquí es igual o más nueva → nada. Es el caso de todos los
+ *      días: se abre un plano que uno mismo guardó. Un cuadro aquí sería un
+ *      cuadro en cada apertura.
+ *
+ * Y HAY UN CUARTO CASO que no estaba en la lista y que sí puede perder trabajo:
+ * una copia del archivo hecha en el explorador (Ctrl-C, Ctrl-V) trae el MISMO
+ * token que el original. Guardarla pisaría al original en la nube, sin error y
+ * sin aviso. Se reconoce porque el renglón de la nube tiene otro nombre: cuando
+ * eso pasa, token nuevo, como en (a). No es una suposición sobre lo que hizo
+ * alguien, es lo único que explica dos archivos con el mismo token y distinto
+ * nombre.
+ */
+(() => {
+  const T = () => (typeof Idioma !== "undefined" && Idioma.ingles);
+  const sinExt = (n) => String(n || "").replace(/\.t101d$/i, "");
+  let ultimaDecision = null;    // para las pruebas y para poder decir qué pasó
+
+  /** El nombre del archivo, sin carpetas, tal como se llama en el disco. */
+  function nombreDeRuta(ruta) {
+    return String(ruta || "").split(/[\\/]/).pop() || "";
+  }
+
+  /** ¿La copia de la nube es más nueva que la de aquí? Sólo si la diferencia es
+   *  de más de dos segundos: los relojes de dos computadoras nunca coinciden al
+   *  milisegundo, y preguntar por medio segundo de diferencia sería preguntar
+   *  siempre. */
+  function masNueva(enLaNube, aqui) {
+    const a = Date.parse(enLaNube), b = Date.parse(aqui);
+    if (isNaN(a)) return false;
+    if (isNaN(b)) return true;        // si aquí no se sabe, la nube manda
+    return a - b > 2000;
+  }
+
+  async function estrenarToken(porque) {
+    try {
+      const r = await fetch("/api/token-nuevo", { method: "POST" });
+      if (!r.ok) return null;
+      const d = await r.json();
+      if (d.resumen) estado.resumen = d.resumen;
+      if (porque) avisar(porque);
+      return d.token;
+    } catch { return null; }
+  }
+
+  /** Se llama después de abrir un archivo. No devuelve nada que nadie espere:
+   *  si algo falla, se sigue trabajando. */
+  async function alAbrir({ ruta, token, modificado } = {}) {
+    ultimaDecision = null;
+    const en = T();
+    if (!window.t101 || !window.t101.nube) return;
+    if (!token) { ultimaDecision = "sin_token"; return; }   // uno de antes de 0.22.0
+
+    let ind;
+    try { ind = await window.t101.nube.indiceYa(); } catch { return; }
+    if (ind.apagada) { ultimaDecision = "apagada"; return; }
+
+    const fila = (ind.archivos || []).find((a) => a.token === token);
+
+    // (a) No es de esta cuenta, o nunca se subió: token nuevo, sin preguntar.
+    if (!fila) {
+      // Si todavía no se ha podido bajar el índice, NO se estrena nada: sería
+      // romperle el token a un archivo propio por no haber podido preguntar.
+      if (ind.todavia_no || ind.sinLicencia) { ultimaDecision = "no_se_sabe"; return; }
+      ultimaDecision = "token_nuevo_ajeno";
+      await estrenarToken(en
+        ? "This file came from another account, so it becomes a new document here."
+        : "Este archivo viene de otra cuenta, así que aquí es un documento nuevo.");
+      return;
+    }
+
+    // (el cuarto caso) Mismo token, otro nombre: es una copia hecha en el
+    // explorador. Token nuevo, o al guardar pisaría al original en la nube.
+    const aqui = nombreDeRuta(ruta);
+    if (aqui && fila.nombre && !fila.ilegible
+        && sinExt(aqui).toLowerCase() !== sinExt(fila.nombre).toLowerCase()) {
+      ultimaDecision = "token_nuevo_copia";
+      await estrenarToken(en
+        ? `This looks like a copy of “${sinExt(fila.nombre)}”, so it becomes a separate document.`
+        : `Esto parece una copia de «${sinExt(fila.nombre)}», así que es un documento aparte.`);
+      return;
+    }
+
+    // (c) La de aquí está al día: nada. Es el caso de todos los días.
+    if (!masNueva(fila.modificado, modificado)) { ultimaDecision = "al_dia"; return; }
+
+    // (b) LA PREGUNTA.
+    ultimaDecision = "pregunta";
+    await preguntar({ fila, ruta });
+  }
+
+  async function preguntar({ fila, ruta }) {
+    const en = T();
+    const cuandoNube = fila.modificado ? new Date(fila.modificado) : null;
+    const comoFecha = (d) => d && !isNaN(d)
+      ? d.toLocaleString(en ? "en-US" : "es-MX", { dateStyle: "medium", timeStyle: "short" })
+      : "—";
+
+    const v = await Dialogo.abrir({
+      titulo: en ? "There's a newer copy in the cloud" : "En la nube hay una copia más nueva",
+      pista: en
+        ? `“${sinExt(fila.nombre)}” was saved from ${fila.equipo || "another computer"} on `
+          + `${comoFecha(cuandoNube)}. The copy on this computer is older.`
+        : `«${sinExt(fila.nombre)}» se guardó desde ${fila.equipo || "otra computadora"} el `
+          + `${comoFecha(cuandoNube)}. La copia de esta computadora es más vieja.`,
+      campos: [
+        { clave: "que", etiqueta: en ? "What to do" : "Qué hacer", tipo: "lista", valor: "nube",
+          opciones: en ? [
+            ["nube", "Use the one from the cloud"],
+            ["esta", "Keep this one (it will replace the cloud copy when you save)"],
+            ["nuevo", "Open this one as a separate document"],
+          ] : [
+            ["nube", "Usar la de la nube"],
+            ["esta", "Quedarme con ésta (al guardar reemplaza la de la nube)"],
+            ["nuevo", "Abrir ésta como documento aparte"],
+          ] },
+      ],
+      aceptar: en ? "Continue" : "Continuar",
+    });
+
+    // Cancelar es quedarse con ésta y no tocar nada: es lo que no pierde nada
+    // ni allá ni aquí. Un cuadro que al cancelar baja un archivo encima del que
+    // está abierto sería lo peor posible.
+    const que = v ? v.que : "esta";
+    ultimaDecision = "escogio_" + que;
+
+    if (que === "nuevo") {
+      await estrenarToken(en
+        ? "This is a separate document now: saving won't touch the one in the cloud."
+        : "Éste es un documento aparte: al guardar no le hace nada al de la nube.");
+      return;
+    }
+    if (que === "esta") {
+      avisar(en
+        ? "Keeping this one. Next time you save, it replaces the cloud copy."
+        : "Se queda ésta. La próxima vez que guardes, reemplaza la de la nube.");
+      return;
+    }
+
+    // «Usar la de la nube»: se baja a una carpeta aparte y se abre desde ahí.
+    // NUNCA se escribe encima del archivo de esta computadora: si alguien se
+    // arrepiente, su archivo sigue igual que antes de abrir nada.
+    avisar(en ? "Downloading the newer copy…" : "Bajando la copia más nueva…");
+    let r;
+    try { r = await window.t101.nube.bajar(fila.token); }
+    catch (e) { r = { error: e.message }; }
+    if (!r || !r.ok) {
+      ultimaDecision = "no_se_pudo_bajar";
+      const porque = r?.sinRed ? (en ? "couldn't reach the server" : "no se pudo llegar al servidor")
+        : r?.noEsta ? (en ? "it's no longer in the cloud" : "ya no está en la nube")
+        : (r?.error || (en ? "unknown error" : "error desconocido"));
+      avisar((en ? "Couldn't download it, so this one stays open: " : "No se pudo bajar, así que se queda ésta: ")
+        + porque, true, 9000);

+
+/* --- Al guardar: la copia sube  (paso 6, 0.22.0) ---
+ *
+ * Mike: «Todo sube por default, o desactivas todo. No hay selección de
+ * archivos». Así que esto se llama en CADA guardado y no pregunta nada.
+ *
+ * Lo único que dice en voz alta es cuando algo salió mal, y sólo una vez por
+ * sesión: si la nube está caída, alguien que guarda cada tres minutos vería el
+ * mismo aviso veinte veces en una hora, y a la tercera dejaría de leerlo. La
+ * pantalla «Mis archivos en la nube» es donde se ve el estado de verdad.
+ */
+(() => {
+  const T = () => (typeof Idioma !== "undefined" && Idioma.ingles);
+  let avisadoEnSesion = false;
+  let ultimaSubida = null;      // para las pruebas y para poder decir qué pasó
+
+  async function alGuardar({ ruta, token, nombre, modificado } = {}) {
+    ultimaSubida = null;
+    if (!window.t101 || !window.t101.nube) return;
+    if (!token) { ultimaSubida = "sin_token"; return; }
+    if (!ruta || !String(ruta).toLowerCase().endsWith(".t101d")) {
+      // Un DXF o un DWG no van a la nube: son exportaciones, no el documento.
+      ultimaSubida = "no_es_t101d";
+      return;
+    }
+
+    let r;
+    try {
+      r = await window.t101.nube.subir({
+        doc: token,
+        nombre: (nombre && /\.t101d$/i.test(nombre)) ? nombre
+              : String(ruta).split(/[\\/]/).pop(),
+        ruta, modificado,
+      });
+    } catch (e) { r = { error: e.message }; }
+
+    if (r && r.ok) { ultimaSubida = "subio"; return; }
+    if (r && r.apagada) { ultimaSubida = "apagada"; return; }
+
+    ultimaSubida = r?.sinRed ? "sin_red" : r?.sinLicencia ? "sin_licencia" : "error";
+    if (avisadoEnSesion) return;
+    avisadoEnSesion = true;
+    const en = T();
+    avisar(r?.sinRed
+      ? (en ? "Saved on this computer. The cloud copy will have to wait: no connection."
+            : "Guardado en esta computadora. La copia en la nube tendrá que esperar: no hay conexión.")
+      : (en ? "Saved on this computer, but the cloud copy didn't go through."
+            : "Guardado en esta computadora, pero la copia en la nube no se pudo hacer."),
+      false, 8000);
+  }
+
+  Nube.alGuardar = alGuardar;
+  Object.defineProperty(Nube, "ultimaSubida", { get: () => ultimaSubida });
+  Nube._olvidarAviso = () => { avisadoEnSesion = false; };
+})();
# fin del parche: el renglon de cola absorbe el recorte del conector.

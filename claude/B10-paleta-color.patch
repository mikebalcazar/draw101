+#p-color{height:24px}
+.paleta{position:fixed;z-index:62;background:var(--panel);border:1px solid var(--linea3);
+  border-radius:var(--r);box-shadow:0 10px 26px var(--sombra);padding:8px;width:216px}
+.paleta .tit{font-size:9.5px;letter-spacing:.06em;text-transform:uppercase;
+  color:var(--txt3);margin:6px 2px 4px}
+.paleta .tit:first-child{margin-top:0}
+.paleta .rej{display:grid;grid-template-columns:repeat(8,1fr);gap:4px}
+.paleta .muestra{width:100%;aspect-ratio:1;padding:0;border:1px solid var(--linea3);
+  border-radius:3px;cursor:pointer}
+.paleta .muestra:hover{outline:2px solid var(--acc2);outline-offset:1px}
+.paleta .muestra.on{outline:2px solid var(--acc);outline-offset:1px}
+.paleta .porcapa{width:100%;margin-bottom:6px;padding:4px;font-size:11px;

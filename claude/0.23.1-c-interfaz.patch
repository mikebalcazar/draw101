+         * motor contesta `copia: null` cuando nada cambió desde el
+         * autoguardado anterior, y no crea renglones en la nube para dibujos
+         * que nunca se guardaron. Ver /api/autoguardar.
+         *
+         * Sin esperarla y sin que pueda tronar nada: el autoguardado ya está
+         * escrito en el disco, que es lo que importa. */
+        if (r && r.subir && window.Nube && Nube.alAutoguardar) {
+          Nube.alAutoguardar({ ruta: r.copia, token: r.token,
+                               nombre: r.nombre, modificado: r.modificado })
+            .catch(() => { /* la nube nunca estorba a un autoguardado */ });
+        }
+      }
+    } catch (_) { /* esto corre solo: nadie lo pidió y nadie debe enterarse */ }
+    setTimeout(vuelta, cada());
+  }
+
+  setTimeout(vuelta, cada());
+  window.Autoguardado = { cada, vuelta };    // para poder medirlo
+})();
 
 /* Sólo hay algo que recuperar si la vez pasada el programa **no** se cerró por

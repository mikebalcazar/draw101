+/* --- Autoguardado  ·  feature 9, y la nube desde 0.23.1 ---------------- */
+/* Mike, 1-oct-2026: «un autosave que por default sea cada 5 minutos, incluida
+ * actualización del archivo nube».
+ *
+ * EL INTERVALO LO MANDA EL MOTOR (`config.AUTOGUARDADO_SEG`, que viaja en el
+ * resumen). Aquí estaba escrito a mano —`120000`— mientras config.py decía 120
+ * segundos: dos números para lo mismo, y cambiar el de config.py no cambiaba
+ * nada. Quien lo leyera creería que sí.
+ *
+ * Y por eso es un `setTimeout` que se reprograma y no un `setInterval`: cuando
+ * esto corre todavía no hay resumen, así que un intervalo fijo se habría
+ * quedado con el valor de respaldo para toda la sesión. */
+(() => {
+  const cada = () => {
+    const s = Number((estado.resumen || {}).autoguardado_seg);
+    return (Number.isFinite(s) && s >= 10 ? s : 300) * 1000;
+  };
+
+  async function vuelta() {
+    try {
+      if (estado.resumen && estado.resumen.sucio) {
+        const r = await post("/api/autoguardar");
+        /* Y LA COPIA A LA NUBE. `subir` sólo viene en true si de verdad se

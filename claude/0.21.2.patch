diff --git a/pruebas/t037_capa_nueva.py b/pruebas/t037_capa_nueva.py
new file mode 100644
index 0000000..09b449c
--- /dev/null
+++ b/pruebas/t037_capa_nueva.py
@@ -0,0 +1,157 @@
+"""t037 · La capa nueva: el cuadro, el comando CAPA, y nada de `prompt()`.
+
+Mike, 22-sep-2026: «le pongo en new layer y no me hace un nuevo layer, no
+sirve el comando».
+
+Lo que pasaba: el botón «Nueva capa» pedía el nombre con `prompt()`, la
+ventanita del navegador. **Electron no tiene `prompt()`** —la llamada lanza
+«prompt() is not supported.»— y como el manejador era `async`, el error se iba
+a una promesa que nadie miraba. Resultado: ni ventana, ni capa, ni aviso. El
+botón quedaba mudo y desde fuera parecía que el comando no servía.
+
+En el navegador de las pruebas `prompt()` sí existe, así que la prueba de
+antes nunca lo iba a cazar. Por eso aquí hay dos cosas distintas:
+
+  · Una revisión **del código**: en `ui/` no puede quedar ninguna llamada a
+    `prompt()`. Es la única forma de cazar esto sin arrancar Electron, y es lo
+    que faltaba. (`alert` y `confirm` sí existen en Electron; ésos se quedan.)
+  · Una revisión **de que funciona**: se pica el botón de verdad, se llena el
+    cuadro y se comprueba que la capa nace en el motor, con su color y su
+    grosor. Y el comando CAPA, que antes no existía aunque el código lo
+    mencionara.
+"""
+
+from __future__ import annotations
+
+import pathlib
+import re
+
+from pruebas import comun, navegador
+
+DESCRIPCION = "capa nueva: cuadro propio, comando CAPA y cero prompt()"
+
+RAIZ = pathlib.Path(__file__).resolve().parent.parent
+
+
+def correr(r: comun.Reporte) -> None:
+    _sin_prompt(r)
+    if not navegador.hay_navegador():
+        r.cierto(True, "(sin Playwright en esta máquina: el resto se salta)")
+        return
+    with navegador.programa() as (pagina, base):
+        navegador.cerrar_inicio(pagina)
+        _el_boton(r, pagina, base)
+        _nombre_repetido(r, pagina)
+        _comando_capa(r, pagina, base)
+        r.igual(pagina.errores, [], "sin errores de JavaScript")
+
+
+# --- 1 · Que no vuelva a entrar un prompt() --------------------------------
+
+def _sin_prompt(r: comun.Reporte) -> None:
+    """`prompt(` en ui/, fuera de comentarios y de cadenas."""
+    culpables = []
+    for archivo in sorted((RAIZ / "ui").glob("*.js")):
+        for n, linea in enumerate(archivo.read_text(encoding="utf-8").splitlines(), 1):
+            limpia = linea.strip()
+            if limpia.startswith("//") or limpia.startswith("*") or limpia.startswith("/*"):
+                continue
+            # `prompt(` pegado a algo (`Dialogo.prompt(`, `.prompt(`) no es la
+            # del navegador; la que importa es la suelta.
+            if re.search(r"(?<![\w.$])prompt\s*\(", linea):
+                culpables.append(f"{archivo.name}:{n}")
+    r.igual(culpables, [],
+            "ningún archivo de ui/ llama a prompt(): Electron no lo tiene")
+
+
+# --- 2 · El botón, picado de verdad ----------------------------------------
+
+def _abrir_cuadro(pagina, selector: str = "#b-capa-nueva"):
+    # Sin `await`: el cuadro devuelve una promesa que no se resuelve hasta que
+    # alguien le pica, y esperarla aquí dejaría colgada la prueba.
+    pagina.evaluate(f"() => {{ document.querySelector('{selector}').click(); }}")
+    pagina.wait_for_selector(".dlg", timeout=5000)
+
+
+def _llenar(pagina, valores: dict) -> None:
+    for clave, valor in valores.items():
+        pagina.evaluate(
+            """([c, v]) => {
+                const el = document.querySelector(`.dlg [data-clave="${c}"]`);
+                el.value = v;
+                el.dispatchEvent(new Event('input', { bubbles: true }));
+                el.dispatchEvent(new Event('change', { bubbles: true }));
+            }""", [clave, valor])
+
+
+def _el_boton(r: comun.Reporte, pagina, base) -> None:
+    _abrir_cuadro(pagina)
+    campos = pagina.evaluate(
+        "() => [...document.querySelectorAll('.dlg [data-clave]')].map((e) => e.dataset.clave)")
+    r.igual(sorted(campos), ["color", "grosor", "nombre", "tipo_linea"],
+            "el botón abre el cuadro de la casa, con nombre, color, grosor y tipo de línea")
+
+    sugerido = pagina.evaluate("() => document.querySelector('.dlg [data-clave=nombre]').value")
+    r.igual(sugerido, "T101-", "con el prefijo de la casa ya puesto")
+
+    _llenar(pagina, {"nombre": "T101-PRUEBA", "color": "#f2603c", "grosor": "50"})
+    pagina.click(".dlg .pie .pri")
+    pagina.wait_for_selector(".dlg", state="detached", timeout=5000)
+    pagina.wait_for_timeout(250)
+
+    capas = {c["nombre"]: c for c in navegador.estado(base)["capas"]}
+    r.cierto("T101-PRUEBA" in capas, "y al aceptar la capa nace en el motor")
+    if "T101-PRUEBA" in capas:
+        c = capas["T101-PRUEBA"]
+        r.igual(c["color"].upper(), "#F2603C", "con el color que se escogió")
+        r.igual(c["grosor"], 50, "y con el grosor que se escogió")
+
+    en_panel = pagina.evaluate(
+        "() => [...document.querySelectorAll('#capas .capa')].some((e) => e.textContent.includes('T101-PRUEBA'))")
+    r.cierto(en_panel, "y aparece en el panel sin recargar")
+
+
+def _nombre_repetido(r: comun.Reporte, pagina) -> None:
+    _abrir_cuadro(pagina)
+    _llenar(pagina, {"nombre": "T101-PRUEBA"})
+    pagina.click(".dlg .pie .pri")
+    pagina.wait_for_timeout(200)
+    abierto = pagina.evaluate("() => !!document.querySelector('.dlg')")
+    queja = pagina.evaluate(
+        "() => { const q = document.querySelector('.dlg .queja'); return q && !q.hidden ? q.textContent : null; }")
+    r.cierto(abierto, "un nombre repetido no cierra el cuadro")
+    r.cierto(bool(queja), f"y dice por qué ({queja})")
+    pagina.evaluate("() => { Dialogo.cerrar(null); }")
+    pagina.wait_for_timeout(150)
+
+
+# --- 3 · El comando CAPA ---------------------------------------------------
+
+def _comando_capa(r: comun.Reporte, pagina, base) -> None:
+    r.cierto(pagina.evaluate("() => Comandos.existe('CAPA')"), "el comando CAPA existe")
+    r.cierto(pagina.evaluate("() => Comandos.existe('LAYER')"), "y en inglés también (LAYER)")
+    r.cierto(pagina.evaluate("() => Comandos.existe('LA')"), "y el atajo LA, como en AutoCAD")
+
+    # Tecleado en la línea de comandos, que es como lo va a usar quien dibuja.
+    navegador.comando(pagina, "CAPA")
+    pagina.wait_for_selector(".dlg", timeout=5000)
+    r.cierto(True, "CAPA tecleado abre el cuadro")
+
+    _llenar(pagina, {"nombre": "T101-MUROS"})
+    pagina.click(".dlg .pie .pri")
+    pagina.wait_for_selector(".dlg", state="detached", timeout=5000)
+    pagina.wait_for_timeout(350)
+
+    est = navegador.estado(base)
+    r.cierto(any(c["nombre"] == "T101-MUROS" for c in est["capas"]), "la capa se crea")
+    r.igual(est["capa_activa"], "T101-MUROS",
+            "y queda puesta a trabajar: los trazos nuevos caen ahí")
+
+    # Cancelar no deja nada a medias.
+    navegador.comando(pagina, "CAPA")
+    pagina.wait_for_selector(".dlg", timeout=5000)
+    pagina.evaluate("() => { Dialogo.cerrar(null); }")
+    pagina.wait_for_timeout(300)
+    est2 = navegador.estado(base)
+    r.igual(len(est2["capas"]), len(est["capas"]), "cancelar el cuadro no crea nada")
+    r.igual(est2["capa_activa"], "T101-MUROS", "ni cambia la capa de trabajo")

     "hueco_origen": 0.625,      # separación entre la pieza y la línea
     "decimales": 0,             # el taller trabaja en milímetros enteros
+    # Los ceros de más no se escriben (el DIMZIN 8 de AutoCAD): 120 y no
+    # 120.00, 120.5 y no 120.50. Pedido de Mike el 29-sep-2026. Importa desde
+    # que se trabaja en centímetros, donde hay que pedir un decimal para no
+    # perder los milímetros y entonces toda medida redonda arrastraba un «.0».
+    "quitar_ceros": True,
     "sufijo": "",
     # 2.5 × 12 = 30 mm de texto en el dibujo, que es lo que Mike pidió ver
     # mientras traza. Con el 1.0 de antes el texto medía 2.5 mm dentro de un
diff --git a/export/dxf.py b/export/dxf.py
index 08cfee3..d3d57c4 100644
--- a/export/dxf.py
+++ b/export/dxf.py
@@ -102,6 +102,10 @@ def _preparar_estilos(doc_dxf, doc: Documento) -> None:
         ds.dxf.dimexe = est.get("ext_linea", 1.25)
         ds.dxf.dimexo = est.get("hueco_origen", 0.625)
         ds.dxf.dimdec = est.get("decimales", 0)
+        # DIMZIN 8: no escribir los ceros de más. Sin esto el DXF se vería
+        # distinto en AutoCAD que aquí, porque el texto de la cota va como
+        # «<>» y quien lo formatea allá es AutoCAD, con SU estilo.
+        ds.dxf.dimzin = 8 if est.get("quitar_ceros", True) else 0
         ds.dxf.dimscale = est.get("factor_escala", 1.0)
         if est.get("estilo_texto") in doc_dxf.styles:
             ds.dxf.dimtxsty = est["estilo_texto"]

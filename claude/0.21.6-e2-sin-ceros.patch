diff --git a/core/cotas.py b/core/cotas.py
index f746b61..7657ee0 100644
--- a/core/cotas.py
+++ b/core/cotas.py
@@ -53,7 +53,21 @@ def formato(valor: float, est: dict, texto: str = "") -> str:
     # 1:20 son 3 450 mm de mueble, y lo que tiene que decir el plano es 3 450.
     valor = valor * float(est.get("factor_medida", 1.0) or 1.0)
     dec = int(est.get("decimales", 0))
-    medida = f"{valor:.{dec}f}" + (est.get("sufijo") or "")
+    medida = f"{valor:.{dec}f}"
+    # Los ceros que no dicen nada se van  ·  Mike, 29-sep-2026: «que por
+    # default eliminen los trailing zeros. Si no hay decimales que marcar, no
+    # se ponen decimales». Es el DIMZIN 8 de AutoCAD, y es lo normal en un
+    # plano de arquitectura: 120 se lee de un vistazo, 120.00 hay que leerlo.
+    #
+    # Importa sobre todo desde que el taller trabaja en CENTÍMETROS: para no
+    # perder los milímetros hay que pedir un decimal, y entonces CADA medida
+    # redonda arrastraba un «.0» que no aporta nada.
+    #
+    # Se quita el punto también, si al quitar los ceros se queda solo. Y si
+    # alguien quiere los ceros de vuelta, es una casilla en el estilo de cota.
+    if dec and est.get("quitar_ceros", True) and "." in medida:
+        medida = medida.rstrip("0").rstrip(".")
+    medida += (est.get("sufijo") or "")
     if not texto:
         return medida
     return texto.replace("<>", medida)
diff --git a/core/documento.py b/core/documento.py

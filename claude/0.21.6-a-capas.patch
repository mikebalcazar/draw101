+def migrar_anotaciones(doc, propio: bool = False) -> bool:
+    """Renombra la capa COTAS a ANOTACIONES al abrir un dibujo viejo.
+
+    Mike lo decidió con botones el 29-sep-2026: se renombra **sólo si la capa
+    es nuestra**. Un DXF del arquitecto puede traer su propia COTAS, con su
+    contenido y su criterio, y cambiarle el nombre a la capa de alguien más al
+    abrir su archivo es de mala educación y además rompe sus referencias.
+
+    Se considera nuestra si el archivo es nuestro (`.t101d`) o si la capa trae
+    la descripción con la que la creamos. En la práctica el `.t101d` es el que
+    sirve casi siempre: un DXF no guarda descripciones de capa, así que de un
+    DXF nuestro tampoco vuelve la firma.
+
+    Si el dibujo ya trae las DOS —alguien creó ANOTACIONES a mano— no se toca
+    nada: fundirlas movería entidades de capa sin que nadie lo pidiera, y eso
+    se deshace peor que se hace.
+
+    Devuelve True si renombró.
+    """
+    vieja, nueva = CAPA_COTAS_VIEJA, CAPA_ANOTACIONES
+    if vieja not in doc.capas or nueva in doc.capas:
+        return False
+    capa = doc.capas[vieja]
+    nuestra = propio or (getattr(capa, "descripcion", "") or "").strip() in (
+        DESCRIPCION_COTAS_VIEJA, DESCRIPCION_ANOTACIONES)
+    if not nuestra:
+        return False
+    doc.capa_modificar(vieja, {"nombre": nueva, "descripcion": DESCRIPCION_ANOTACIONES})
+    return True
+
+

diff --git a/ui/ajustes.js b/ui/ajustes.js
index 15bd40f..745e743 100644
--- a/ui/ajustes.js
+++ b/ui/ajustes.js
@@ -212,6 +212,22 @@ const Ajustes = (() => {
   /* --- Configuración general: idioma y tema  ·  0.19.0 ------------------ */
   async function general() {
     const prefs = estado.prefs || {};
+
+    /* LA NUBE (0.22.0). Va aquí y no en un panel propio porque es UN
+     * interruptor: Mike lo decidió así —«Todo sube por default, o desactivas
+     * todo. No hay selección de archivos»—, y un panel entero para una casilla
+     * sería inventarle complejidad a una decisión que ya se tomó.
+     *
+     * No se guarda en las preferencias del motor sino con la licencia y la
+     * llave, en la carpeta de draw101, porque es de ESTA computadora: quien
+     * apaga la nube en la laptop del taller no la apaga en la de su casa. Y el
+     * motor no tiene por qué saber de la nube: el cifrado vive en Electron.
+     *
+     * Sin la app instalada (navegador suelto) la casilla no sale: ofrecer un
+     * interruptor que no hace nada es peor que no ofrecerlo. */
+    const hayNube = !!(window.t101 && window.t101.nube);
+    const nubeAntes = hayNube ? await window.t101.nube.encendida() : false;
+
     const v = await Dialogo.abrir({
       titulo: "Configuración de draw101",
       pista: "Los comandos se aceptan en los dos idiomas siempre (LINE y LINEA). Cambiar el idioma recarga la ventana.",
@@ -223,10 +239,20 @@ const Ajustes = (() => {
         { clave: "parpadeo_comando", etiqueta: "Parpadeo al ejecutar", tipo: "casilla",
           valor: prefs.parpadeo_comando !== false,
           pista: "Un parpadeo casi imperceptible del lienzo cuando un comando cambia algo" },
+        ...(hayNube ? [{ clave: "nube", etiqueta: "Copia en la nube", tipo: "casilla",
+          valor: nubeAntes,
+          pista: "Cada plano que guardes se copia a tu cuenta, cifrado. Al volver a prenderla "
+               + "no se sube lo que ya tienes en la computadora: se va subiendo conforme lo abras." }] : []),
       ],
       aceptar: "Aplicar",
     });
     if (!v) return;
+    if (hayNube && !!v.nube !== nubeAntes) {
+      await window.t101.nube.prender(!!v.nube);
+      avisar(!!v.nube
+        ? Tr("La nube queda encendida. Lo que guardes de aquí en adelante se copia a tu cuenta.")
+        : Tr("La nube queda apagada en esta computadora. Lo que ya está subido se queda donde está."));
+    }
     if (!!v.parpadeo_comando !== (prefs.parpadeo_comando !== false)) {
       await guardarPrefs({ parpadeo_comando: !!v.parpadeo_comando });
     }
diff --git a/ui/app.js b/ui/app.js
index f8af750..1444e15 100644
--- a/ui/app.js
+++ b/ui/app.js
@@ -432,6 +432,8 @@ const Archivo = (() => {
     { name: "DWG", extensions: ["dwg"] },
   ];
 
+  let revisandoNube = false;   // ver el bloque de la nube, dentro de `abrir`
+
   /** Abre un plano. En pestaña nueva, salvo que la de enfrente esté en blanco:
    *  abrir tres planos seguidos no debe dejar dos pestañas vacías detrás. */
   async function abrir(ruta) {
@@ -450,6 +452,23 @@ const Archivo = (() => {
       avisar(`Abierto: ${nat} entidades editables` +
         (pre ? ` y ${pre} que se conservan tal cual (${Object.keys(inf.preservadas).join(", ").toLowerCase()}).` : "."));
     }
+    /* LA NUBE, después de abrir (0.22.0). Va al final a propósito: el plano ya
+     * está en pantalla, así que si esto pregunta algo, se pregunta sobre algo
+     * que ya se puede ver, y si falla, el plano abrió igual.
+     *
+     * No se espera —salvo que haya que preguntar, y de eso se encarga Nube—, y
+     * `revisandoNube` evita el círculo: cuando alguien escoge «usar la de la
+     * nube», Nube baja el archivo y lo abre por aquí otra vez, y sin esta
+     * guardia volvería a preguntar por el archivo que acaba de bajar. */
+    if (window.Nube && Nube.alAbrir && !revisandoNube) {
+      revisandoNube = true;
+      try {
+        await Nube.alAbrir({ ruta, token: estado.resumen.token,
+                             modificado: estado.resumen.guardado_en });
+      } catch (e) { /* la nube nunca estorba al plano abierto */ }
+      finally { revisandoNube = false; }
+    }
+
     // Un DWG grande y sin ODA: se ofrece instalarlo, una sola vez en la vida
     // del programa (el motor lleva la cuenta). No se espera: el plano ya abrió.
     const mb = estado.resumen.sugerir_oda;
@@ -494,6 +513,21 @@ const Archivo = (() => {
     try {
       aplicar(await post("/api/guardar", { ruta }));
       avisar(comoOtro ? `Guardado como ${estado.resumen.nombre}.` : "Guardado.");
+      /* Y LA COPIA A LA NUBE (0.22.0). Va DESPUÉS de avisar que se guardó, y
+       * sin esperarla, por una razón que no es de estilo: el archivo ya está
+       * escrito en el disco: lo que importa ya pasó. Si la subida tardara o
+       * fallara, «Guardado» seguiría siendo cierto, y guardar no puede ponerse
+       * lento porque el wifi ande mal.
+       *
+       * `Nube.alGuardar` decide si sube (la nube puede estar apagada) y se
+       * calla si no puede. Lo que NUNCA hace es convertir un guardado bueno en
+       * un error. */
+      if (window.Nube && Nube.alGuardar) {
+        Nube.alGuardar({ ruta, token: estado.resumen.token,
+                         nombre: estado.resumen.nombre,
+                         modificado: estado.resumen.guardado_en })
+          .catch(() => { /* la nube nunca estorba a un guardado que ya está */ });
+      }
       return true;
     } catch (e) { avisar(e.message, true); sinLicencia(e); return false; }
   }

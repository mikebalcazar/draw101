diff --git a/ui/styles.css b/ui/styles.css
index 0c811de..b1fa933 100644
--- a/ui/styles.css
+++ b/ui/styles.css
@@ -880,3 +880,27 @@ select.campo-hoja{position:absolute;z-index:6;box-sizing:border-box;padding:2px
   border-radius:var(--r);box-shadow:0 6px 20px var(--sombra);font-size:12.5px}
 #letrero-version span{color:var(--txt)}
 #letrero-version button{white-space:nowrap}
+
+/* Mis archivos en la nube (0.22.0). Reusa .dlg: lo único propio es la lista,
+   la barra de búsqueda y los botones de orden. Un panel aparte sería otro
+   juego de colores y bordes que mantener al día. */
+.dlg.nube .panel{width:min(620px,calc(100% - 48px))}
+.nube-barra{display:flex;gap:8px;align-items:center;flex-wrap:wrap;
+  padding:10px 18px;border-bottom:1px solid var(--linea)}
+.nube-busca{flex:1 1 180px;min-width:140px}
+.nube-ordenes{display:flex;gap:4px;flex-wrap:wrap}
+.nube-ordenes .gh{font-size:11px;padding:3px 8px}
+.nube-ordenes .gh.puesto{background:var(--acc2);color:#fff;border-color:var(--acc2)}
+.nube-aviso{padding:8px 18px;font-size:11.5px;line-height:1.45;color:var(--txt2);
+  background:var(--panel3);border-bottom:1px solid var(--linea2)}
+.nube-lista{min-height:120px;max-height:52vh;gap:0;display:block}
+.nube-fila{display:grid;grid-template-columns:1fr auto auto;gap:10px;
+  align-items:center;padding:8px 0;border-bottom:1px solid var(--linea2);cursor:default}
+.nube-fila:last-child{border-bottom:none}
+.nube-fila:hover{background:var(--panel3)}
+.nube-nom{font-size:12.5px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
+.nube-fila.ilegible .nube-nom{color:var(--txt3);font-style:italic}
+.nube-dat{font-size:11px;color:var(--txt3);white-space:nowrap}
+.nube-vacio{padding:26px 0;text-align:center;font-size:12px;color:var(--txt3)}
+.nube-pie{padding:11px 18px;border-top:1px solid var(--linea);
+  display:flex;justify-content:flex-end}

diff --git a/ui/marco.js b/ui/marco.js
index 7ee81bf..e30e638 100644
--- a/ui/marco.js
+++ b/ui/marco.js
@@ -217,6 +217,40 @@ const Marco = (() => {
     }
   }
 
+  /* La columna de la nube  ·  0.22.2
+   *
+   * No se reimplementa aqui: se monta la MISMA lista del cuadro NUBE (ver
+   * Nube.explorador). El buscador sin acentos, las palabras en cualquier
+   * orden, los cuatro ordenes y los cinco avisos son trabajo ya medido; una
+   * segunda copia habria nacido sin nada de eso.
+   *
+   * SE MONTA AL ABRIR Y SE SUELTA AL CERRAR, y no una sola vez al arrancar,
+   * por dos razones: la lista se refresca sola cada vez que uno vuelve a la
+   * pantalla, y una respuesta del servidor que llega tarde no pinta sobre una
+   * pantalla que ya se cerro.
+   *
+   * SI LA VERSION NO TRAE NUBE la columna no sale en vez de salir vacia: una
+   * columna titulada «En la nube» y siempre en blanco se lee como que la nube
+   * esta rota. */
+  let expNube = null;
+
+  function montarNube() {
+    const host = $("#iNube");
+    const col = $("#iEnNube");
+    if (!host || !col) return;
+    if (!(window.Nube && Nube.explorador)) { col.hidden = true; return; }
+    col.hidden = false;
+    soltarNube();
+    expNube = Nube.explorador(host);
+    // Sin await: la pantalla de inicio sale completa de inmediato y la lista
+    // se llena sola. Esperar a la red aqui seria mirar un hueco al arrancar.
+    Promise.resolve(expNube.cargar()).catch(() => {});
+  }
+
+  function soltarNube() {
+    if (expNube) { expNube.soltar(); expNube = null; }
+  }
+
   function abrirInicio() {
     const caja = $("#inicio");
     if (!caja) return;
@@ -227,11 +261,13 @@ const Marco = (() => {
     const v = $("#iVersion");
     if (v && estado.version) v.textContent = `versión ${estado.version.version}`;
     pintarRecientes();
+    montarNube();
   }
 
   function cerrarInicio() {
     const caja = $("#inicio");
     if (caja) caja.classList.remove("on");
+    soltarNube();
   }
 
   const inicioAbierto = () => !!$("#inicio") && $("#inicio").classList.contains("on");

 /** Las impresoras instaladas en esta máquina, tal como las ve Windows. */
+/* Una imagen al portapapeles del sistema. Va por el proceso principal y no
+ * por `navigator.clipboard` de la página: ahí una imagen grande se atora y
+ * hace falta que la ventana tenga el foco, que es justo lo que no pasa cuando
+ * se teclea SS y se va uno a otro programa a pegar. */
+ipcMain.handle("copiar-imagen", async (_e, dataURL) => {
+  const { clipboard, nativeImage } = require("electron");
+  if (typeof dataURL !== "string" || !dataURL.startsWith("data:image/")) return false;
+  const img = nativeImage.createFromDataURL(dataURL);
+  if (img.isEmpty()) return false;
+  clipboard.writeImage(img);
+  return true;
+});
+

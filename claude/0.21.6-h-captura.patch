+/* CAPTURA (SS) · Mike, 29-sep-2026: «necesito un comando de screenshot que
+ * ponga en el portapapeles un screenshot de la ventana de modelo. El shortcut
+ * podría ser SS».
+ *
+ * Se copia **el lienzo del dibujo y nada más**: no la mira, ni los agarres de
+ * la selección, ni la gomita del borrador, que viven en el lienzo de encima.
+ * Es lo que uno quiere pegar en un correo o en una cotización —el plano, no la
+ * foto de alguien trabajando—. El fondo se pinta a mano con el color del tema
+ * porque el lienzo es transparente: sin eso, pegado en Word, sale en negro.
+ *
+ * Dos caminos al portapapeles, en este orden:
+ *   1. Electron, por el puente: `clipboard.writeImage`. Es el que corre en la
+ *      máquina de Mike y el que aguanta imágenes grandes.
+ *   2. El del navegador (`ClipboardItem`), para el banco de pruebas y por si
+ *      algún día esto corre en una pestaña. */
+async function _imagenDelModelo() {
+  const dpr = window.devicePixelRatio || 1;
+  const fuera = document.createElement("canvas");
+  fuera.width = lienzo.width;
+  fuera.height = lienzo.height;
+  const c = fuera.getContext("2d");
+  const tema = getComputedStyle(document.documentElement)
+    .getPropertyValue("--lienzo").trim();
+  c.fillStyle = tema || "#ffffff";
+  c.fillRect(0, 0, fuera.width, fuera.height);
+  c.drawImage(lienzo, 0, 0);
+  return { lienzo: fuera, ancho: Math.round(fuera.width / dpr),
+           alto: Math.round(fuera.height / dpr) };
+}
+
+async function _alPortapapeles(cv) {
+  if (window.t101 && window.t101.copiarImagen) {
+    return await window.t101.copiarImagen(cv.toDataURL("image/png"));
+  }
+  if (navigator.clipboard && window.ClipboardItem) {
+    const trozo = await new Promise((r) => cv.toBlob(r, "image/png"));
+    if (!trozo) return false;
+    await navigator.clipboard.write([new ClipboardItem({ "image/png": trozo })]);
+    return true;
+  }
+  return false;
+}
+
+Comandos.registrar({
+  nombre: "CAPTURA", alias: ["SS", "SCREENSHOT"],
+  ayuda: "Copia al portapapeles una imagen de lo que se ve del dibujo",
+  correr: async () => {
+    try {
+      const { lienzo: cv, ancho, alto } = await _imagenDelModelo();
+      const fue = await _alPortapapeles(cv);
+      if (fue) Comandos.eco(`Copiado al portapapeles: ${ancho} × ${alto} px.`, "bien");
+      else Comandos.eco("No se pudo llegar al portapapeles desde aquí.", "mal");
+    } catch (e) {
+      Comandos.eco("No se pudo copiar: " + (e && e.message ? e.message : e), "mal");
+    }
+  },
+});
+

+class Empalme(BaseModel):
+    id1: str
+    pick1: list[float]
+    id2: str
+    pick2: list[float]
+    radio: float
+
+
+@app.post("/api/empalme")
+def empalme_entidades(entrada: Empalme):
+    """EMPALME  ·  arco de radio dado tangente a dos curvas, recortándolas.
+
+    La geometría vive en `core/empalme.py`; aquí sólo se envuelve en una
+    transacción —para que un Ctrl+Z deshaga el recorte de las dos curvas y el
+    arco nuevo de un golpe, no en tres pasos— y se arma el parche.
+
+    Los `pick` son los puntos donde el dibujante picó cada curva. No son
+    decoración: son lo que decide cuál de las cuatro soluciones posibles se
+    construye y qué lado de cada curva se conserva.
+    """
+    try:
+        with S.candado:
+            with S.doc.transaccion("Empalme"):
+                r = mod_empalme.aplicar(S.doc, entrada.id1, entrada.pick1,
+                                        entrada.id2, entrada.pick2,
+                                        entrada.radio)
+            parche = _parche([entrada.id1, entrada.id2, r["arco"]])
+    except (CapaBloqueada, ValueError) as exc:
+        _error(exc)
+    return {**r, "parche": parche, **S.resumen()}
